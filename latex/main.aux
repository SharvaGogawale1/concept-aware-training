\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces SWORDS results on 74 held-out targets, mean over three seeds with standard deviation across seeds. \textsc  {Base}{} is deterministic and has one value. \textsc  {Code}{} leads on every ranking metric. Our arms lead on GOLD NLL and perplexity, which is the retention side of the trade rather than the benchmark's target.}}{4}{table.caption.5}\protected@file@percent }
\newlabel{tab:main}{{2}{4}{SWORDS results on 74 held-out targets, mean over three seeds with standard deviation across seeds. \armB {} is deterministic and has one value. \armPF {} leads on every ranking metric. Our arms lead on GOLD NLL and perplexity, which is the retention side of the trade rather than the benchmark's target}{table.caption.5}{}}
\@LN@col{1}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Paired bootstrap deltas against \textsc  {Code}{}, mean over three seeds. Negative is worse for p@1 and AUROC and better for GOLD NLL. All entries have all three seeds agreeing in sign; $\dagger $ marks the one cell where a confidence interval includes zero. Every other entry satisfies the pre-registered claim rule. Arm definitions are in Table~\ref {tab:arms}.}}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:vsp1f}{{3}{4}{Paired bootstrap deltas against \armPF {}, mean over three seeds. Negative is worse for p@1 and AUROC and better for GOLD NLL. All entries have all three seeds agreeing in sign; $\dagger $ marks the one cell where a confidence interval includes zero. Every other entry satisfies the pre-registered claim rule. Arm definitions are in Table~\ref {tab:arms}}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Concept weight sweep on \textsc  {Pw}{}. $\Delta $GAP is the change from the previous row. Gains saturate while GOLD NLL keeps rising, crossing the untouched checkpoint ($4.446$) at $\alpha = 6$.}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tab:alpha}{{4}{4}{Concept weight sweep on \armMP {}. $\Delta $GAP is the change from the previous row. Gains saturate while GOLD NLL keeps rising, crossing the untouched checkpoint ($4.446$) at $\alpha = 6$}{table.caption.7}{}}
