# Paper PDFs (large binary files — reference locally, don't push)
*.pdf

# Experiment outputs
wandb/
output/
outputs/
checkpoints/
runs/

# Old notebooks with hardcoded tokens — never commit these
prev_*_old.ipynb
*_old.ipynb

# Markdown: planning/working docs stay local (CLAUDE.md, AGENTS.md, PlanA.md,
# future_directions.md, chen_email_draft.md, …). README.md is the one exception —
# it is the repo's front page for collaborators.
# NOTE: this rule does not affect files already tracked by git (e.g. the vendored
# transformers/**/*.md docs); those stay tracked deliberately.
*.md
!README.md

# Stray dot-less copy of this file
gitignore.txt

# Python
__pycache__/
*.py[cod]
*.pyo
.env
.venv
venv/
*.egg-info/
dist/
build/

# macOS
.DS_Store

# Jupyter checkpoints
.ipynb_checkpoints/
