+        log_mass = torch.where(count >= 1, log_mass, torch.zeros_like(log_mass))
+        mass_slot = torch.where(count >= 1, -log_mass, torch.zeros_like(log_mass))
+        balance_slot = -torch.log(count.clamp(min=1).float()) - (mean_log - log_mass)
+        balance_slot = torch.where(count >= 2, balance_slot, torch.zeros_like(balance_slot))
