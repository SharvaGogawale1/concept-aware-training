+# ---- discriminative objectives: pool / rank / list_uniform / list_verifier -----------
+import math
+import pytest
+from train import DISCRIMINATIVE_OBJECTIVES, validate_objective_config
+
+
+def _disc(objective, theta=0.4):
+    trainer = _scorer(objective, True)
+    trainer.verifier_theta = theta
+    return trainer
+
+
+def _logits_from_probs(probs):
+    return torch.log(torch.tensor([[probs]], dtype=torch.float32)).requires_grad_(True)
+
+
+def test_single_positive_makes_pool_rank_and_list_uniform_identical():
+    """With one alternative there is nothing to share or to balance."""
+    logits = torch.randn(1, 1, 6, generator=torch.Generator().manual_seed(1)).requires_grad_(True)
+    args = (logits, [0], [0], [[1]], [[3, 4]], [None])
+    values = [_disc(o)._compute_concept_losses_vectorized(*args)[0]
+              for o in ("pool", "rank", "list_uniform")]
+    assert torch.allclose(values[0], values[1]) and torch.allclose(values[1], values[2])
+
+
+def test_discriminative_objectives_are_zero_without_negatives_and_keep_the_slot():
+    """Common eligibility rule: no negatives -> exactly zero, still in the denominator."""
+    logits = torch.randn(1, 2, 6, generator=torch.Generator().manual_seed(2)).requires_grad_(True)
+    for objective in DISCRIMINATIVE_OBJECTIVES:
+        trainer = _disc(objective)
+        alone = trainer._compute_concept_losses_vectorized(
+            logits, [0], [0], [[1, 2]], [[3]], [[0.9, 0.7]])[0]
+        both = trainer._compute_concept_losses_vectorized(
+            logits, [0, 0], [0, 1], [[1, 2], [1, 2]], [[3], []], [[0.9, 0.7], [0.9, 0.7]])[0]
+        assert torch.isclose(both, alone / 2), objective
+        assert trainer._last_eligible == 0.5
+
+
+def test_per_positive_ranking_sees_the_neglected_positive():
+    """The audit's numbers: positives .20 and .001 against negative mass .02."""
+    logits = _logits_from_probs([0.20, 0.001, 0.02, 0.779])
+    args = (logits, [0], [0], [[0, 1]], [[2]], [None])
+    pool = _disc("pool")._compute_concept_losses_vectorized(*args)[0]
+    rank = _disc("rank")._compute_concept_losses_vectorized(*args)[0]
+    assert torch.isclose(pool, torch.tensor(-math.log(0.201 / 0.221)), atol=1e-4)      # .095
+    assert torch.isclose(rank, torch.tensor(0.5 * (-math.log(0.20 / 0.22)
+                                                   - math.log(0.001 / 0.021))), atol=1e-4)  # 1.570
+    assert rank > 10 * pool
+
+
+def test_list_uniform_equals_pool_plus_within_positive_kl_plus_log_n():
+    logits = torch.randn(1, 1, 7, generator=torch.Generator().manual_seed(3)).requires_grad_(True)
+    positives, negatives = [1, 2, 4], [5]
+    args = (logits, [0], [0], [positives], [negatives], [None])
+    pool = _disc("pool")._compute_concept_losses_vectorized(*args)[0]
+    listwise = _disc("list_uniform")._compute_concept_losses_vectorized(*args)[0]
+    probs = F.softmax(logits[0, 0].float(), dim=-1)
+    q = probs[positives] / probs[positives].sum()
+    n = len(positives)
+    kl = sum((1.0 / n) * math.log((1.0 / n) / q[i].item()) for i in range(n))
+    assert torch.isclose(listwise, pool + kl + math.log(n), atol=1e-5)
+
+
+def test_list_verifier_equal_scores_is_uniform_and_unscored_falls_back():
+    logits = torch.randn(1, 1, 7, generator=torch.Generator().manual_seed(4)).requires_grad_(True)
+    base = (logits, [0], [0], [[1, 2]], [[5]])
+    uniform = _disc("list_uniform")._compute_concept_losses_vectorized(*base, [None])[0]
+    equal = _disc("list_verifier")._compute_concept_losses_vectorized(*base, [[0.9, 0.9]])[0]
+    unscored = _disc("list_verifier")._compute_concept_losses_vectorized(*base, [[0.9, None]])[0]
+    assert torch.isclose(equal, uniform) and torch.isclose(unscored, uniform)
+    # Graded: theta .4 -> weights (.5, .1) / .6.
+    graded = _disc("list_verifier")._compute_concept_losses_vectorized(*base, [[0.9, 0.5]])[0]
+    log_p = F.log_softmax(logits[0, 0].float(), dim=-1)
+    log_all = torch.logsumexp(log_p[[1, 2, 5]], dim=0)
+    expected = log_all - ((0.5 / 0.6) * log_p[1] + (0.1 / 0.6) * log_p[2])
+    assert torch.isclose(graded, expected, atol=1e-5)
+    assert not torch.isclose(graded, uniform)
+
+
+def test_verifier_scores_stay_aligned_through_exclusion():
+    """Weights are taken over the SURVIVING alternatives: the excluded observed
+    token's score must go with it, not shift onto a neighbour."""
+    words = [[{"shift_position": 0, "target_token_id": 5,
+               "synonym_token_ids": [7, 5, 9], "synonym_scores": [0.9, 0.6, 0.5]}]]
+    flat = _flattener(True)._build_concept_targets(words, 1, 4, return_scores=True)
+    assert flat[2] == [[7, 9]]
+    assert flat[4] == [[0.9, 0.5]]
+
+
+def test_discriminative_objectives_have_zero_direct_gradient_off_the_candidate_list():
+    """The vocabulary softmax cancels: the observed token (and every other token
+    outside P u N) gets no direct gradient.  This is what the audit checked by
+    hand, and it is why slot NTP has to be declared separately."""
+    for objective in DISCRIMINATIVE_OBJECTIVES:
+        logits = torch.randn(1, 1, 6, generator=torch.Generator().manual_seed(5)).requires_grad_(True)
+        loss = _disc(objective)._compute_concept_losses_vectorized(
+            logits, [0], [0], [[1, 2]], [[4]], [[0.9, 0.6]])[0]
+        loss.backward()
+        grad = logits.grad[0, 0]
+        assert torch.allclose(grad[[0, 3, 5]], torch.zeros(3), atol=1e-6), objective
+        assert grad[[1, 2, 4]].abs().sum() > 0, objective
+
+
+def test_validation_refuses_stacked_terms_and_inclusive_sets():
+    validate_objective_config("rank", True, 0.0, "none", 1.0)
+    validate_objective_config("set_marginal", False, 1.0, "uniform", None)   # old arms untouched
+    validate_objective_config("set_marginal", False, 0.0, "mass", None)
+    with pytest.raises(ValueError):
+        validate_objective_config("rank", False, 0.0, "none", 1.0)            # observed token in P
+    with pytest.raises(ValueError):
+        validate_objective_config("pool", True, 1.0, "none", 1.0)             # + old contrastive term
+    with pytest.raises(ValueError):
+        validate_objective_config("list_uniform", True, 0.0, "uniform", 1.0)  # + auxiliary
+    with pytest.raises(ValueError):
+        validate_objective_config("list_verifier", True, 0.0, "none", None)   # NTP policy not stated
+    with pytest.raises(ValueError):
+        validate_objective_config("rank", True, 0.0, "mass", 1.0)             # + auxiliary
