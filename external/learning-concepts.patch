new file mode 100644
index 0000000..7ceceab
--- /dev/null
+++ b/tests/fixtures/make_pre_factorial_reference.py
@@ -0,0 +1,111 @@
+"""Golden values of the auxiliary terms as they were BEFORE the factorial gammas.
+
+Run once against the patch state of commit 2dcc130 (learning-concepts.patch before
+round 2); test_factorial.py::test_h_* checks that the current trainer reproduces these
+values and gradients, so `--alt-aux mass` and `--alt-aux uniform` -- the code paths
+that trained every existing checkpoint -- are provably unchanged.
+
+    python tests/fixtures/make_pre_factorial_reference.py
+"""
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+from transformers.modeling_outputs import CausalLMOutputWithPast
+
+from train import ConceptLossTrainer
+
+OUT = Path(__file__).with_name("pre_factorial_reference.json")
+V = 40
+
+
+def aux_inputs():
+    g = torch.Generator().manual_seed(1234)
+    logits = torch.randn(1, 5, V, generator=g) * 3.0
+    # |A| in {0, 1, 2, 5, 10}; token 0 plays the observed token and is never in A.
+    alts = [[], [3], [4, 9], [5, 6, 7, 8, 11], list(range(12, 22))]
+    return logits, [0] * 5, list(range(5)), alts
+
+
+def loss_inputs():
+    g = torch.Generator().manual_seed(99)
+    logits = torch.randn(2, 12, V, generator=g) * 2.5
+    # Peaked rows so some slots sit above the tau = 0.6 cutoff of the set marginal.
+    logits[0, 2, 7] += 9.0
+    logits[1, 5, 3] += 9.0
+    ids = torch.randint(1, V, (2, 12), generator=g)
+    mask = torch.ones(2, 12, dtype=torch.long)
+    mask[1, 10:] = 0
+    words = [
+        [{"shift_position": 2, "target_token_id": 7, "synonym_token_ids": [8, 9, 10]},
+         {"shift_position": 4, "target_token_id": 11, "synonym_token_ids": []},
+         {"shift_position": 6, "target_token_id": 12, "synonym_token_ids": [13]},
+         # duplicate alternative and the observed token repeated in the list
+         {"shift_position": 8, "target_token_id": 14, "synonym_token_ids": [15, 15, 14, 16]}],
+        [{"shift_position": 1, "target_token_id": 20, "synonym_token_ids": list(range(21, 31))},
+         {"shift_position": 5, "target_token_id": 3, "synonym_token_ids": [2, 4]},
+         {"shift_position": 9, "target_token_id": 33, "synonym_token_ids": [34, 35, 36, 37, 38]}],
+    ]
+    return logits, ids, mask, words
+
+
+def full_trainer(alt_aux, weight):
+    t = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    t.concept_loss_weight = 1.0
+    t.concept_objective = "set_marginal"
+    t.target_mass = 0.6
+    t.slot_ntp_weight = None
+    t.contrast_beta = 0.0
+    t.alt_aux, t.alt_aux_weight = alt_aux, weight
+    t.exclude_target = False
+    t.randomized_synonyms = False
+    t.use_weighted_ce = False
+    t.max_synonyms_per_content_word = None
+    t.max_content_words = None
+    t.verifier_theta = 0.4
+    t._last_eligible = None
+    t._is_evaluating = False
+    t.state = SimpleNamespace(global_step=0)
+    t.args = SimpleNamespace(logging_steps=50, seed=42)
+    return t
+
+
+def main():
+    ref = {"aux": {}, "loss": {}}
+    logits, b, s, alts = aux_inputs()
+    ref["aux_inputs"] = {"logits": logits, "b": b, "s": s, "alts": alts}
+    for kind in ("uniform", "mass", "within_kl"):
+        x = logits.clone().requires_grad_(True)
+        t = ConceptLossTrainer.__new__(ConceptLossTrainer)
+        t.alt_aux = kind
+        value = t._compute_alt_aux_loss(x, b, s, alts)
+        value.backward()
+        ref["aux"][kind] = {"value": value.detach(), "grad": x.grad.detach().clone()}
+
+    logits, ids, mask, words = loss_inputs()
+    ref["loss_inputs"] = {"logits": logits, "input_ids": ids, "attention_mask": mask, "words": words}
+    for kind, weight in (("none", 0.0), ("uniform", 0.125), ("mass", 0.125), ("within_kl", 0.125),
+                         ("uniform", 0.0625), ("mass", 0.0625)):
+        theta = logits.clone().requires_grad_(True)
+        loss = full_trainer(kind, weight).compute_loss(
+            lambda **kw: CausalLMOutputWithPast(logits=theta),
+            {"input_ids": ids, "attention_mask": mask, "content_words": words})
+        loss.backward()
+        ref["loss"][f"{kind}_{weight}"] = {"value": loss.detach(), "grad": theta.grad.detach().clone()}
+    def plain(o):
+        if isinstance(o, torch.Tensor):
+            return {"tensor": o.tolist(), "dtype": str(o.dtype)}
+        if isinstance(o, dict):
+            return {k: plain(v) for k, v in o.items()}
+        if isinstance(o, list):
+            return [plain(v) for v in o]
+        return o
+    # JSON, not torch.save: the fixture travels inside a text patch.  float32 values
+    # round-trip exactly through Python floats.
+    OUT.write_text(json.dumps(plain(ref)))
+    print("wrote", OUT)
+
+
+if __name__ == "__main__":
+    main()
