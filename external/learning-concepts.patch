+        """
+        if not flat_b_idx:
+            zero = logits.sum() * 0.0
+            return {term: zero for term in FACTORIAL_TERMS}
+        device = logits.device
+        b_t = torch.tensor(flat_b_idx, device=device, dtype=torch.long)
+        s_t = torch.tensor(flat_shift_idx, device=device, dtype=torch.long)
+        log_probs = F.log_softmax(logits[b_t, s_t].float(), dim=-1)
+
+        num_targets = len(flat_alt_ids)
+        width = max(1, max(len(ids) for ids in flat_alt_ids))
