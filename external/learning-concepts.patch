+import torch
+import torch.nn.functional as F
+
+from conceptlib.sequence_scoring import continuation_log_probability
+from train_hierarchy import RELATION_TEMPLATES, relation_prompt
+
+
+def test_exact_multitoken_continuation_matches_bruteforce():
+    logits = torch.tensor([
+        [1.0, 0.0, -1.0],
+        [0.0, 2.0, -1.0],
+        [1.0, -1.0, 3.0],
+    ])
+    observed = continuation_log_probability(logits, [1, 2])
+    expected = F.log_softmax(logits[0], dim=-1)[1] + F.log_softmax(logits[1], dim=-1)[2]
+    assert torch.allclose(observed, expected)
+
+
+def test_every_multitoken_position_receives_gradient():
+    logits = torch.zeros((3, 4), requires_grad=True)
+    continuation_log_probability(logits, [1, 2]).backward()
+    assert logits.grad[0].abs().sum() > 0
+    assert logits.grad[1].abs().sum() > 0
+
+
+def test_hierarchy_bridge_is_explicitly_detached():
+    logits = torch.tensor([1.0, 2.0], requires_grad=True)
+    q = torch.softmax(logits, dim=0).detach()
+    relation_scores = torch.tensor([-2.0, -3.0], requires_grad=True)
+    loss = -torch.logsumexp(torch.log(q) + relation_scores, dim=0)
+    loss.backward()
+    assert logits.grad is None
+    assert relation_scores.grad is not None
+
+
+def test_exactly_three_registered_templates():
+    assert RELATION_TEMPLATES == (
+        "In this context, {substitute} is a type of",
+        "{substitute} and other",
+        "A more general term for {substitute} is",
+    )
+
+
+def test_relation_templates_preserve_context_and_substitute_identity():
+    for index in range(3):
+        prompt = relation_prompt("The terrier barked.", "terrier", index)
+        assert "The terrier barked." in prompt
+        assert "terrier" in prompt
