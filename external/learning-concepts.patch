diff --git a/conceptlib/sequence_scoring.py b/conceptlib/sequence_scoring.py
new file mode 100644
index 0000000..c86ef1f
--- /dev/null
+++ b/conceptlib/sequence_scoring.py
@@ -0,0 +1,79 @@
+"""Exact continuation scoring shared by hierarchy training and evaluation."""
+
+from typing import Iterable, List, Sequence, Tuple
+
+import torch
+import torch.nn.functional as F
+
+
+def encode_continuation(tokenizer, prefix: str, continuation: str) -> Tuple[List[int], List[int]]:
+    """Tokenize ``prefix + continuation`` and return full ids plus continuation ids.
+
+    Tokenizing the concatenated string is essential: many tokenizers encode a
+    word differently at a boundary than they do in isolation.
+    """
+    prefix_ids = tokenizer.encode(prefix, add_special_tokens=True)
+    full_ids = tokenizer.encode(prefix + continuation, add_special_tokens=True)
+    if full_ids[: len(prefix_ids)] != prefix_ids:
+        # Boundary merges can change the final prefix token.  A trailing space
+        # keeps the relation templates at a stable token boundary.
+        raise ValueError("prefix is not a token-prefix of the full continuation")
+    continuation_ids = full_ids[len(prefix_ids) :]
+    if not continuation_ids:
+        raise ValueError("empty continuation")
+    return full_ids, continuation_ids
+
+
+def left_truncate(full_ids: Sequence[int], continuation_len: int, max_length: int) -> List[int]:
+    """Left-truncate context only; never discard continuation tokens."""
+    if continuation_len >= max_length:
+        raise ValueError("continuation alone reaches max_length")
+    if len(full_ids) <= max_length:
+        return list(full_ids)
+    return list(full_ids[-max_length:])
+
+
+def continuation_log_probability(logits: torch.Tensor, continuation_ids: Sequence[int]) -> torch.Tensor:
+    """Exact log p(c|x) from teacher-forced logits for one packed sequence."""
+    n = len(continuation_ids)
+    if n <= 0 or logits.shape[0] < n + 1:
+        raise ValueError("invalid continuation/logit lengths")
+    positions = logits[-n - 1 : -1]
+    labels = torch.as_tensor(continuation_ids, device=logits.device, dtype=torch.long)
+    return F.log_softmax(positions.float(), dim=-1).gather(1, labels[:, None]).sum()
+
+
+def exact_candidate_log_probs(
+    model,
+    tokenizer,
+    prompts_and_candidates: Iterable[Tuple[str, str]],
+    max_length: int = 256,
+    microbatch_size: int = 16,
+) -> torch.Tensor:
+    """Score variable-length candidates exactly, with candidate microbatching."""
+    encoded = []
+    for prompt, candidate in prompts_and_candidates:
+        full, continuation = encode_continuation(tokenizer, prompt, candidate)
+        full = left_truncate(full, len(continuation), max_length)
+        encoded.append((full, continuation))
+    if not encoded:
+        param = next(model.parameters())
+        return param.sum()[None] * 0.0
+
+    device = next(model.parameters()).device
+    pad_id = tokenizer.pad_token_id if tokenizer.pad_token_id is not None else tokenizer.eos_token_id
+    scores = []
+    for start in range(0, len(encoded), microbatch_size):
+        chunk = encoded[start : start + microbatch_size]
+        width = max(len(full) for full, _ in chunk)
+        ids = torch.full((len(chunk), width), pad_id, dtype=torch.long, device=device)
+        mask = torch.zeros_like(ids)
+        lengths = []
+        for row, (full, _) in enumerate(chunk):
+            ids[row, : len(full)] = torch.tensor(full, device=device)
+            mask[row, : len(full)] = 1
+            lengths.append(len(full))
+        logits = model(input_ids=ids, attention_mask=mask).logits
+        for row, ((_, continuation), length) in enumerate(zip(chunk, lengths)):
+            scores.append(continuation_log_probability(logits[row, :length], continuation))
+    return torch.stack(scores)
diff --git a/data/audit_concept_data.py b/data/audit_concept_data.py
new file mode 100644
index 0000000..aaee0a4
--- /dev/null
+++ b/data/audit_concept_data.py
@@ -0,0 +1,87 @@
+"""Hard-fail audit for the 8k/1k/1k Zhang concept splits."""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from transformers import AutoTokenizer
+
+
+def read(path):
+    return [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
+
+
+def audit_split(name, path, tokenizer):
+    rows = read(path)
+    bad_target = bad_candidate = empty = slots = 0
+    for row in rows:
+        ids = tokenizer(row["input_sequence"], add_special_tokens=True)["input_ids"]
+        for slot in row.get("content_word_responses", row.get("content_words", [])):
+            slots += 1
+            position = int(slot["position"])
+            expected = tokenizer.encode(" " + str(slot["word"]).strip(), add_special_tokens=False)
+            if position >= len(ids) or len(expected) != 1 or ids[position] != expected[0]:
+                bad_target += 1
+            concepts = [slot.get("word"), *slot.get("synonyms", [])]
+            if not concepts:
+                empty += 1
+            for concept in concepts:
+                if len(tokenizer.encode(" " + str(concept).strip(), add_special_tokens=False)) != 1:
+                    bad_candidate += 1
+    return rows, {
+        "split": name,
+        "path": str(Path(path).resolve()),
+        "sha256": hashlib.sha256(Path(path).read_bytes()).hexdigest(),
+        "rows": len(rows),
+        "slots": slots,
+        "target_alignment_failures": bad_target,
+        "non_single_token_concepts": bad_candidate,
+        "empty_concept_sets": empty,
+        "observed_target_included_by_schema": True,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--train", required=True)
+    parser.add_argument("--validation", required=True)
+    parser.add_argument("--test", required=True)
+    parser.add_argument("--tokenizer", required=True)
+    parser.add_argument("--report", required=True)
+    parser.add_argument("--allow-nonstandard-sizes", action="store_true")
+    args = parser.parse_args()
+    tokenizer = AutoTokenizer.from_pretrained(args.tokenizer)
+    all_rows, reports = {}, []
+    for name, path in [("train", args.train), ("validation", args.validation), ("test", args.test)]:
+        all_rows[name], report = audit_split(name, path, tokenizer)
+        reports.append(report)
+    expected = {"train": 8000, "validation": 1000, "test": 1000}
+    sizes = {r["split"]: r["rows"] for r in reports}
+    if sizes != expected and not args.allow_nonstandard_sizes:
+        raise AssertionError(f"expected {expected}, observed {sizes}")
+    identities = {
+        name: {row["input_sequence"] for row in rows} for name, rows in all_rows.items()
+    }
+    overlaps = {
+        "train_validation": len(identities["train"] & identities["validation"]),
+        "train_test": len(identities["train"] & identities["test"]),
+        "validation_test": len(identities["validation"] & identities["test"]),
+    }
+    failures = sum(
+        report["target_alignment_failures"]
+        + report["non_single_token_concepts"]
+        + report["empty_concept_sets"]
+        for report in reports
+    )
+    if failures or any(overlaps.values()):
+        raise AssertionError(f"concept audit failed: failures={failures}, overlaps={overlaps}")
+    result = {"splits": reports, "context_overlap": overlaps, "passed": True}
+    report_path = Path(args.report)
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    report_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(result, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/data/build_contrastive_negatives.py b/data/build_contrastive_negatives.py
new file mode 100644
index 0000000..14352d3
--- /dev/null
+++ b/data/build_contrastive_negatives.py
@@ -0,0 +1,165 @@
+"""Attach conservative, automatically mined negatives to Zhang concept JSONL.
+
+The source `embedding_synonyms.py` records the model's top next-token pool and
+each candidate's contextual cosine.  A candidate is retained as a negative only
+when it is a plausible next token, is below a conservative similarity ceiling,
+has the target WordNet POS, is not a morphological variant, and shares no
+WordNet synset with the target or an accepted synonym.
+
+The output preserves the original schema and adds `negatives` and
+`negative_scores` to each item in `content_word_responses`.
+"""
+from __future__ import annotations
+
+import argparse
+import glob
+import json
+import os
+from collections import Counter
+from pathlib import Path
+
+from nltk.corpus import wordnet as wn
+from nltk.stem import PorterStemmer
+
+
+POS_MAP = {"NOUN": wn.NOUN, "VERB": wn.VERB, "ADJ": wn.ADJ}
+
+
+def _normalise(word: str) -> str:
+    return " ".join(str(word).strip().lower().replace("_", " ").split())
+
+
+def _wordnet_form(word: str) -> str:
+    return _normalise(word).replace(" ", "_")
+
+
+def load_topk(patterns: list[str]) -> dict[tuple[str, int], dict]:
+    index = {}
+    paths = sorted({path for pattern in patterns for path in glob.glob(pattern)})
+    if not paths:
+        raise FileNotFoundError(f"no top-k files matched: {patterns}")
+    for path in paths:
+        with open(path, encoding="utf-8") as handle:
+            for line in handle:
+                row = json.loads(line)
+                text = row["input_sequence"]
+                for target in row.get("content_word_topk", []):
+                    index[(text, int(target["position"]))] = target
+    return index
+
+
+def mine_target(target: dict, topk: dict, max_cosine: float,
+                max_negatives: int, reasons: Counter) -> tuple[list[str], list[float]]:
+    pos = target.get("pos") or topk.get("pos")
+    wn_pos = POS_MAP.get(pos)
+    if wn_pos is None:
+        reasons["unsupported_pos"] += 1
+        return [], []
+
+    positives = [target["word"], *target.get("synonyms", [])]
+    positive_norm = {_normalise(word) for word in positives}
+    positive_stems = {PorterStemmer().stem(word) for word in positive_norm}
+    positive_synsets = {
+        synset
+        for word in positives
+        for synset in wn.synsets(_wordnet_form(word), pos=wn_pos)
+    }
+
+    tokens = topk.get("topk_tokens", [])
+    scores = topk.get("topk_scores", [])
+    if len(tokens) != len(scores):
+        reasons["missing_similarity_scores"] += 1
+        return [], []
+
+    negatives, negative_scores = [], []
+    for candidate, score in zip(tokens, scores):
+        clean = _normalise(candidate)
+        if not clean or clean in positive_norm:
+            reasons["positive_or_empty"] += 1
+            continue
+        if float(score) > max_cosine:
+            reasons["too_similar"] += 1
+            continue
+        if PorterStemmer().stem(clean) in positive_stems:
+            reasons["morphological_variant"] += 1
+            continue
+        candidate_synsets = set(wn.synsets(_wordnet_form(clean), pos=wn_pos))
+        if not candidate_synsets:
+            reasons["no_matching_wordnet_pos"] += 1
+            continue
+        if candidate_synsets & positive_synsets:
+            reasons["shared_synset"] += 1
+            continue
+        negatives.append(str(candidate).strip())
+        negative_scores.append(float(score))
+        if len(negatives) >= max_negatives:
+            break
+    if not negatives:
+        reasons["no_safe_negative"] += 1
+    return negatives, negative_scores
+
+
+def build(source: str, topk_patterns: list[str], output: str,
+          report: str, max_cosine: float, max_negatives: int) -> dict:
+    topk_index = load_topk(topk_patterns)
+    reasons = Counter()
+    rows = slots = covered = 0
+    Path(output).parent.mkdir(parents=True, exist_ok=True)
+    with open(source, encoding="utf-8") as src, open(output, "w", encoding="utf-8") as dst:
+        for line in src:
+            row = json.loads(line)
+            rows += 1
+            text = row["input_sequence"]
+            for target in row.get("content_word_responses", []):
+                slots += 1
+                key = (text, int(target["position"]))
+                pool = topk_index.get(key)
+                if pool is None:
+                    reasons["missing_topk_slot"] += 1
+                    target["negatives"] = []
+                    target["negative_scores"] = []
+                    continue
+                target.setdefault("pos", pool.get("pos"))
+                negatives, scores = mine_target(
+                    target, pool, max_cosine, max_negatives, reasons
+                )
+                target["negatives"] = negatives
+                target["negative_scores"] = scores
+                covered += bool(negatives)
+            dst.write(json.dumps(row, ensure_ascii=False) + "\n")
+
+    summary = {
+        "source": os.path.abspath(source),
+        "output": os.path.abspath(output),
+        "rows": rows,
+        "slots": slots,
+        "slots_with_negatives": covered,
+        "negative_coverage": covered / max(slots, 1),
+        "max_contextual_cosine": max_cosine,
+        "max_negatives_per_slot": max_negatives,
+        "rejection_reasons": dict(sorted(reasons.items())),
+    }
+    Path(report).parent.mkdir(parents=True, exist_ok=True)
+    with open(report, "w", encoding="utf-8") as handle:
+        json.dump(summary, handle, indent=2, sort_keys=True)
+    return summary
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", required=True)
+    parser.add_argument("--topk", action="append", required=True,
+                        help="glob for topk_*.jsonl; repeatable")
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--report", required=True)
+    parser.add_argument("--max-cosine", type=float, default=0.35)
+    parser.add_argument("--max-negatives", type=int, default=20)
+    args = parser.parse_args()
+    print(json.dumps(build(
+        args.source, args.topk, args.output, args.report,
+        args.max_cosine, args.max_negatives,
+    ), indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/data/build_hierarchy_dataset.py b/data/build_hierarchy_dataset.py
new file mode 100644
index 0000000..b498df5
--- /dev/null
+++ b/data/build_hierarchy_dataset.py
@@ -0,0 +1,153 @@
+"""Enrich Zhang-format concept JSONL with auditable WordNet hierarchy labels.
+
+Synonym supervision is retained for nouns, verbs, and adjectives.  Hierarchy
+supervision is added only for noun/verb slots with one defensible synset and at
+least one direct hypernym.  HyperLex is never read by this builder.
+"""
+
+import argparse
+import collections
+import hashlib
+import json
+import random
+from pathlib import Path
+
+from nltk.corpus import wordnet as wn
+
+
+POS_MAP = {"NOUN": wn.NOUN, "VERB": wn.VERB, "n": wn.NOUN, "v": wn.VERB}
+
+
+def norm(text):
+    return str(text).strip().lower().replace("_", " ")
+
+
+def lemma_surfaces(synsets):
+    return sorted({norm(lemma.name()) for synset in synsets for lemma in synset.lemmas()})
+
+
+def select_sense(word, synonyms, pos):
+    wn_pos = POS_MAP.get(pos)
+    if wn_pos is None:
+        return None, "hierarchy_pos_not_noun_or_verb"
+    synonym_norms = {norm(x) for x in synonyms}
+    candidates = []
+    for synset in wn.synsets(norm(word).replace(" ", "_"), pos=wn_pos):
+        names = {norm(lemma.name()) for lemma in synset.lemmas()}
+        if names & synonym_norms:
+            candidates.append(synset)
+    candidates = list({synset.name(): synset for synset in candidates}.values())
+    if not candidates:
+        return None, "no_synset_intersection"
+    if len(candidates) != 1:
+        return None, "ambiguous_synset_intersection"
+    if not candidates[0].hypernyms():
+        return None, "no_direct_hypernym"
+    return candidates[0], None
+
+
+def enrich(rows, seed):
+    frequency = collections.Counter(
+        norm(slot.get("word", ""))
+        for row in rows
+        for slot in row.get("content_word_responses", row.get("content_words", []))
+    )
+    retained_by_pos = collections.defaultdict(list)
+    exclusions = collections.Counter()
+    all_slots = []
+
+    for row_idx, row in enumerate(rows):
+        slots = row.get("content_word_responses", row.get("content_words", []))
+        for slot_idx, slot in enumerate(slots):
+            slot.setdefault("slot_id", f"{row_idx}:{slot_idx}")
+            slot["target_frequency"] = frequency[norm(slot.get("word", ""))]
+            slot["concept_set_size"] = 1 + len(slot.get("synonyms", []))
+            synset, reason = select_sense(
+                slot.get("word", ""), slot.get("synonyms", []), slot.get("pos")
+            )
+            if synset is None:
+                slot["hierarchy_exclusion_reason"] = reason
+                slot["hypernyms"] = []
+                exclusions[reason] += 1
+            else:
+                slot["synset"] = synset.name()
+                slot["hypernyms"] = lemma_surfaces(synset.hypernyms())
+                slot["wordnet_depth"] = synset.min_depth()
+                slot["hierarchy_exclusion_reason"] = None
+                retained_by_pos[synset.pos()].append(slot)
+            all_slots.append(slot)
+
+    # Relation-destroying control: same-POS hypernyms from another retained
+    # slot.  A deterministic rotation avoids accidental self-assignment.
+    rng = random.Random(seed)
+    for pos, slots in retained_by_pos.items():
+        donor_sets = [list(slot["hypernyms"]) for slot in slots]
+        for slot in slots:
+            alternatives = [donor for donor in donor_sets if donor != slot["hypernyms"]]
+            slot["shuffled_hypernyms"] = list(rng.choice(alternatives)) if alternatives else []
+
+    retained = [s for s in all_slots if s.get("hierarchy_exclusion_reason") is None]
+    excluded = [s for s in all_slots if s.get("hierarchy_exclusion_reason") is not None]
+
+    def describe(values):
+        values = sorted(float(x) for x in values if x is not None)
+        if not values:
+            return {"n": 0, "mean": None, "median": None, "min": None, "max": None}
+        mid = len(values) // 2
+        median = values[mid] if len(values) % 2 else (values[mid - 1] + values[mid]) / 2
+        return {
+            "n": len(values), "mean": sum(values) / len(values), "median": median,
+            "min": values[0], "max": values[-1],
+        }
+
+    report = {
+        "rows": len(rows),
+        "slots_total": len(all_slots),
+        "slots_retained": len(retained),
+        "coverage": len(retained) / max(1, len(all_slots)),
+        "coverage_by_pos": {},
+        "exclusion_reasons": dict(exclusions),
+        "retained_frequency": describe(s.get("target_frequency") for s in retained),
+        "excluded_frequency": describe(s.get("target_frequency") for s in excluded),
+        "retained_concept_set_size": describe(s.get("concept_set_size") for s in retained),
+        "excluded_concept_set_size": describe(s.get("concept_set_size") for s in excluded),
+        "wordnet_depth": describe(s.get("wordnet_depth") for s in retained),
+        "shuffled_control_coverage": (
+            sum(bool(s.get("shuffled_hypernyms")) for s in retained) / max(1, len(retained))
+        ),
+    }
+    for pos in sorted({str(s.get("pos")) for s in all_slots}):
+        group = [s for s in all_slots if str(s.get("pos")) == pos]
+        kept = [s for s in group if s.get("hierarchy_exclusion_reason") is None]
+        report["coverage_by_pos"][pos] = {
+            "total": len(group), "retained": len(kept),
+            "coverage": len(kept) / max(1, len(group)),
+        }
+    return rows, report
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--input", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--report", required=True)
+    parser.add_argument("--seed", type=int, default=42)
+    args = parser.parse_args()
+
+    source = Path(args.input)
+    rows = [json.loads(line) for line in source.read_text().splitlines() if line.strip()]
+    rows, report = enrich(rows, args.seed)
+    report["source_sha256"] = hashlib.sha256(source.read_bytes()).hexdigest()
+
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text("".join(json.dumps(row) + "\n" for row in rows))
+    report["output_sha256"] = hashlib.sha256(output.read_bytes()).hexdigest()
+    report_path = Path(args.report)
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(report, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
