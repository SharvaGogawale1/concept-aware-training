@@ -0,0 +1,95 @@
+import torch
+import torch.nn.functional as F
+from types import SimpleNamespace
+
+from train import ConceptLossTrainer
+
+
+def _trainer(objective="set_marginal", contrast_beta=0.0, target_mass=1.1):
+    trainer = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    trainer.concept_objective = objective
+    trainer.contrast_beta = contrast_beta
+    trainer.target_mass = target_mass
+    return trainer
+
+
+def test_single_member_objectives_equal_cross_entropy():
+    logits = torch.tensor([[[1.0, 2.0, -1.0]]], requires_grad=True)
+    expected = -F.log_softmax(logits[0, 0], dim=-1)[1]
+    args = (logits, [0], [0], [[1]], [[]])
+    marginal, _ = _trainer("set_marginal")._compute_concept_losses_vectorized(*args)
+    uniform, _ = _trainer("uniform")._compute_concept_losses_vectorized(*args)
+    assert torch.allclose(marginal, expected)
+    assert torch.allclose(uniform, expected)
+
+
+def test_released_set_marginal_matches_reference_implementation():
+    logits = torch.tensor([[[0.2, 1.3, -0.7, 0.8]]], requires_grad=True)
+    trainer = _trainer("set_marginal", target_mass=0.95)
+    observed, _ = trainer._compute_concept_losses_vectorized(
+        logits, [0], [0], [[1, 3]], [[]]
+    )
+    probabilities = F.softmax(logits[0, 0].float(), dim=-1)
+    mass = probabilities[1] + probabilities[3]
+    expected = torch.where(mass >= 0.95, torch.zeros_like(mass), -torch.log(mass.clamp(min=1e-9)))
+    assert torch.allclose(observed, expected, atol=1e-7)
+
+
+def test_uniform_does_not_inherit_set_mass_cutoff():
+    logits = torch.tensor([[[8.0, -8.0, -9.0]]], requires_grad=True)
+    uniform, _ = _trainer("uniform", target_mass=0.6)._compute_concept_losses_vectorized(
+        logits, [0], [0], [[0, 1]], [[]]
+    )
+    assert uniform.item() > 1.0
+
+
+def test_contrastive_is_zero_without_negatives_and_positive_with_them():
+    logits = torch.tensor([[[1.0, 2.0, 3.0]]], requires_grad=True)
+    trainer = _trainer("set_marginal", contrast_beta=1.0)
+    _, empty = trainer._compute_concept_losses_vectorized(
+        logits, [0], [0], [[1]], [[]]
+    )
+    _, present = trainer._compute_concept_losses_vectorized(
+        logits, [0], [0], [[1]], [[2]]
+    )
+    assert empty.item() == 0.0
+    assert present.item() > 0.0
+
+
+def test_every_uniform_candidate_receives_gradient():
+    logits = torch.zeros((1, 1, 4), requires_grad=True)
+    uniform, _ = _trainer("uniform")._compute_concept_losses_vectorized(
+        logits, [0], [0], [[1, 2]], [[]]
+    )
+    uniform.backward()
+    assert logits.grad[0, 0, 1].abs() > 0
+    assert logits.grad[0, 0, 2].abs() > 0
+
+
+def test_lambda_zero_is_exact_teacher_forced_ntp_and_ignores_padding():
+    # Must return the real output type: compute_loss reads
+    # outputs.get("logits", outputs[0]), and Python evaluates that default
+    # eagerly, so a plain dict raises KeyError(0) before .get() is ever called.
+    from transformers.modeling_outputs import CausalLMOutputWithPast
+
+    class ToyModel:
+        def __init__(self, logits):
+            self.logits = logits
+        def __call__(self, **kwargs):
+            return CausalLMOutputWithPast(logits=self.logits)
+
+    logits = torch.tensor([[[2.0, 0.0, -1.0], [0.0, 3.0, -2.0], [7.0, -4.0, 0.0]]])
+    trainer = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    trainer.concept_loss_weight = 0
+    trainer.contrast_beta = 0
+    trainer.use_weighted_ce = False
+    trainer._is_evaluating = False
+    trainer.state = SimpleNamespace(global_step=0)
+    trainer.args = SimpleNamespace(logging_steps=50)
+    ids = torch.tensor([[0, 1, 2]])
+    mask = torch.tensor([[1, 1, 0]])
+    observed = trainer.compute_loss(ToyModel(logits), {
+        "input_ids": ids, "attention_mask": mask, "content_words": [[]]
+    })
+    expected = F.cross_entropy(logits[:, 0, :], ids[:, 1])
+    assert torch.allclose(observed, expected)
