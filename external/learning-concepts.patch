+    def _compute_alt_aux_loss(self, logits, flat_b_idx, flat_shift_idx, flat_alt_ids):
+        """Auxiliary loss over the alternatives at each content slot.
+
+        Averaged over ALL content slots, like the concept loss: a slot with no
+        alternative (or, for within_kl, a single one, where KL is identically
+        zero) contributes zero and stays in the denominator, so the weight means
+        the same thing in every arm.
+        """
+        if not flat_b_idx:
+            return logits.sum() * 0.0
+        device = logits.device
+        b_t = torch.tensor(flat_b_idx, device=device, dtype=torch.long)
+        s_t = torch.tensor(flat_shift_idx, device=device, dtype=torch.long)
+        log_probs = F.log_softmax(logits[b_t, s_t].float(), dim=-1)
+
+        num_targets = len(flat_alt_ids)
+        width = max(1, max(len(ids) for ids in flat_alt_ids))
+        padded = torch.zeros(num_targets, width, dtype=torch.long, device=device)
+        mask = torch.zeros(num_targets, width, dtype=torch.bool, device=device)
+        for i, ids in enumerate(flat_alt_ids):
+            padded[i, :len(ids)] = torch.tensor(ids, dtype=torch.long, device=device)
+            mask[i, :len(ids)] = True
+
+        gathered = log_probs.gather(1, padded)
+        count = mask.sum(dim=1)
+        mean_log = gathered.masked_fill(~mask, 0.0).sum(dim=1) / count.clamp(min=1)
+        log_mass = torch.logsumexp(gathered.masked_fill(~mask, float("-inf")), dim=1)
+        log_mass = torch.where(count >= 1, log_mass, torch.zeros_like(log_mass))
+        if self.alt_aux == "uniform":
+            per_slot = -mean_log
+            keep = count >= 1
+        elif self.alt_aux == "mass":
