+# The objective at a concept slot is ONE of these.  The first two are the released
+# set marginal and the per-word uniform loss; the rest discriminate the alternatives
+# from verified negatives and REPLACE the slot term rather than being added to it.
+#   pool          : -log [ P(A) / (P(A) + P(N)) ]
+#   rank          : -(1/|A|) sum_a log [ p_a / (p_a + P(N)) ]     every alternative beats N
+#   list_uniform  : -(1/|A|) sum_a log [ p_a / (P(A) + P(N)) ]   = pool + KL(u || q_A) + log|A|
+#   list_verifier : -sum_a w_a log [ p_a / (P(A) + P(N)) ],  w_a ∝ max(s_a - theta, 0)
+# A is the alternative set with the observed token excluded; N the verified negatives.
+CONCEPT_OBJECTIVES = ("set_marginal", "uniform", "pool", "rank", "list_uniform", "list_verifier")
+DISCRIMINATIVE_OBJECTIVES = ("pool", "rank", "list_uniform", "list_verifier")
+# Auxiliaries on the alternatives only (observed token excluded), added to the main
+# objective.  uniform = mass + within_kl + log n, exactly:
+#   uniform   : -(1/n) sum_a log p_a
+#   mass      : -log P(A)             push on a proportional to q_a = p_a / P(A)
+#   within_kl : KL(u || q_A)          push on a proportional to 1/n - q_a
+ALT_AUX_KINDS = ("none", "uniform", "mass", "within_kl")
+# Round 2: the same terms with independent weights, added to the released concept
+# loss L_Z (which is left exactly as it is).  At a supervised slot t, with C_t the
+# concept set, y_t the observed token and A_t = C_t \ {y_t} (deduplicated):
+#   R_t (gamma_mass)     = -log M(A_t)                 = the `mass` auxiliary
+#   B_t (gamma_balance)  = KL(uniform(A_t) || q_t)     = the `within_kl` auxiliary
+#   S_t (gamma_uncapped) = -log M({y_t} u A_t)         L_Z's term with no tau cutoff
+# Each is averaged over ALL supervised slots, so |A_t| = 0 adds zero to R and B
+# (and |A_t| = 1 zero to B) while the slot stays in the denominator.
+FACTORIAL_TERMS = ("mass", "balance", "uncapped")
+
+
+def validate_factorial_config(concept_objective, exclude_target, randomized_synonyms,
+                              contrast_beta, alt_aux, gamma_mass, gamma_balance,
+                              gamma_uncapped):
+    """The factorial weights are defined only on top of the released concept loss."""
+    gammas = {"gamma_mass": gamma_mass, "gamma_balance": gamma_balance,
+              "gamma_uncapped": gamma_uncapped}
+    for name, value in gammas.items():
+        if float(value) < 0 or not math.isfinite(float(value)):
+            raise ValueError(f"{name} must be a finite non-negative number; got {value}")
+    if not any(float(v) for v in gammas.values()):
+        return
+    problems = []
+    if concept_objective != "set_marginal":
+        problems.append("--concept-objective set_marginal")
+    if exclude_target:
+        problems.append("no --exclude-target (C_t must contain the observed token)")
+    if randomized_synonyms:
+        problems.append("no --randomized-synonyms")
+    if float(contrast_beta or 0.0) != 0.0:
+        problems.append("--contrast-beta 0")
+    if alt_aux != "none":
+        problems.append("--alt-aux none (use the gammas instead, never both)")
+    if problems:
+        raise ValueError("the factorial gammas require " + "; ".join(problems))
+
+
+def validate_objective_config(concept_objective, exclude_target, contrast_beta, alt_aux,
+                              slot_ntp_weight):
+    """Refuse the combinations that would train something other than what was declared.
+
+    A discriminative objective is the whole slot objective.  Stacking the old
+    contrastive term or an auxiliary on top would train the A + B + C construction
+    the comparison exists to avoid; including the observed token would let the
+    ranking be satisfied by mass NTP already put there; and the NTP policy at the
+    slot is a separate decision, so it must be stated rather than inherited from
+    1 - lambda.
+    """
+    if concept_objective not in CONCEPT_OBJECTIVES:
+        raise ValueError(f"concept_objective must be one of {CONCEPT_OBJECTIVES}")
+    if alt_aux not in ALT_AUX_KINDS:
+        raise ValueError(f"alt_aux must be one of {ALT_AUX_KINDS}")
+    if concept_objective not in DISCRIMINATIVE_OBJECTIVES:
+        return
+    problems = []
+    if not exclude_target:
+        problems.append("--exclude-target (the alternatives must not contain the observed token)")
+    if float(contrast_beta or 0.0) != 0.0:
+        problems.append("--contrast-beta 0 (the pooled term is not an add-on here)")
+    if alt_aux != "none":
+        problems.append("--alt-aux none (no auxiliary on top of a discriminative objective)")
+    if slot_ntp_weight is None:
+        problems.append("an explicit --slot-ntp-weight (the NTP policy at the slot is declared, not inherited)")
+    if problems:
+        raise ValueError(
+            f"--concept-objective {concept_objective} requires " + "; ".join(problems))
+
