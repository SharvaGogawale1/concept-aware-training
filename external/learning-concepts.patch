diff --git a/eval/eval_perplexity_explicit.py b/eval/eval_perplexity_explicit.py
new file mode 100644
index 0000000..14dfd5b
--- /dev/null
+++ b/eval/eval_perplexity_explicit.py
@@ -0,0 +1,93 @@
+"""Global and content-word NTP metrics for explicit base/checkpoint/adapter paths."""
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from peft import PeftConfig, PeftModel
+from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig
+
+
+def load_model(reference, base_model, dtype, device, quantize_4bit=True):
+    quantization = None
+    load_kwargs = {"torch_dtype": dtype}
+    if quantize_4bit and device.type == "cuda":
+        quantization = BitsAndBytesConfig(
+            load_in_4bit=True, bnb_4bit_compute_dtype=torch.float16,
+            bnb_4bit_quant_type="nf4", bnb_4bit_use_double_quant=False,
+        )
+        load_kwargs = {"quantization_config": quantization, "device_map": {"": "cuda:0"}}
+    path = Path(reference)
+    if path.is_dir() and (path / "adapter_config.json").exists():
+        base = base_model or PeftConfig.from_pretrained(reference).base_model_name_or_path
+        model = AutoModelForCausalLM.from_pretrained(base, **load_kwargs)
+        model = PeftModel.from_pretrained(model, reference)
+    else:
+        model = AutoModelForCausalLM.from_pretrained(reference, **load_kwargs)
+    return model.eval() if quantization is not None else model.to(device).eval()
+
+
+@torch.no_grad()
+def evaluate(model, tokenizer, rows, max_length, device):
+    global_nll, content_nll, other_nll = [], [], []
+    alignment_failures = 0
+    for row in rows:
+        encoded = tokenizer(row["input_sequence"], truncation=True, max_length=max_length, return_tensors="pt")
+        ids = encoded["input_ids"].to(device)
+        logits = model(input_ids=ids, attention_mask=encoded["attention_mask"].to(device), use_cache=False).logits
+        losses = F.cross_entropy(logits[:, :-1].float().transpose(1, 2), ids[:, 1:], reduction="none")[0]
+        content_positions = set()
+        for slot in row.get("content_word_responses", row.get("content_words", [])):
+            position = int(slot["position"])
+            if 0 < position < ids.shape[1]:
+                expected = tokenizer.encode(" " + str(slot["word"]).strip(), add_special_tokens=False)
+                if len(expected) == 1 and expected[0] == int(ids[0, position]):
+                    content_positions.add(position - 1)
+                else:
+                    alignment_failures += 1
+        global_nll.extend(losses.tolist())
+        content_nll.extend(float(losses[p]) for p in sorted(content_positions))
+        other_nll.extend(float(losses[p]) for p in range(len(losses)) if p not in content_positions)
+
+    def report(values):
+        mean = sum(values) / len(values) if values else None
+        return {"n": len(values), "mean_nll": mean, "perplexity": math.exp(mean) if mean is not None else None}
+    return {
+        "global": report(global_nll),
+        "content_words": report(content_nll),
+        "other_positions": report(other_nll),
+        "alignment_failures": alignment_failures,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--checkpoints", nargs="+", required=True)
+    parser.add_argument("--base-model", required=True)
+    parser.add_argument("--test-jsonl", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--max-length", type=int, default=256)
+    parser.add_argument("--no-quantize", action="store_true")
+    args = parser.parse_args()
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    dtype = torch.bfloat16 if device.type == "cuda" else torch.float32
+    tokenizer = AutoTokenizer.from_pretrained(args.base_model)
+    if tokenizer.pad_token_id is None:
+        tokenizer.pad_token = tokenizer.eos_token
+    rows = [json.loads(line) for line in open(args.test_jsonl) if line.strip()]
+    results = []
+    for checkpoint in args.checkpoints:
+        model = load_model(checkpoint, args.base_model, dtype, device, not args.no_quantize)
+        results.append({"checkpoint": checkpoint, **evaluate(model, tokenizer, rows, args.max_length, device)})
+        del model
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.output).write_text(json.dumps(results, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
