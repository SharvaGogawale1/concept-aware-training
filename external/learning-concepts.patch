diff --git a/eval/eval_concept_sets.py b/eval/eval_concept_sets.py
new file mode 100644
index 0000000..2066e29
--- /dev/null
+++ b/eval/eval_concept_sets.py
@@ -0,0 +1,104 @@
+"""Intrinsic metrics for Zhang-format gold-inclusive single-token concept sets."""
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from transformers import AutoTokenizer
+
+from eval_perplexity_explicit import load_model
+
+
+@torch.no_grad()
+def evaluate(model, tokenizer, rows, max_length, device):
+    records = []
+    for row_id, row in enumerate(rows):
+        enc = tokenizer(row["input_sequence"], truncation=True, max_length=max_length, return_tensors="pt")
+        ids = enc["input_ids"].to(device)
+        logits = model(input_ids=ids, attention_mask=enc["attention_mask"].to(device), use_cache=False).logits
+        for slot_id, slot in enumerate(row.get("content_word_responses", [])):
+            pos = int(slot["position"])
+            if not 0 < pos < ids.shape[1]:
+                continue
+            target = int(ids[0, pos])
+            candidates = [target]
+            for surface in slot.get("synonyms", []):
+                encoded = tokenizer.encode(" " + str(surface).strip(), add_special_tokens=False)
+                if len(encoded) == 1 and encoded[0] not in candidates:
+                    candidates.append(encoded[0])
+            logp = F.log_softmax(logits[0, pos - 1].float(), dim=-1)
+            values = logp[torch.tensor(candidates, device=device)]
+            probs = values.exp()
+            normalised = probs / probs.sum()
+            records.append({
+                "row_id": row_id,
+                "slot_id": slot_id,
+                "set_mass": float(probs.sum()),
+                "set_nll": float(-torch.logsumexp(values, dim=0)),
+                "observed_target_nll": float(-values[0]),
+                "alternative_nll": float(-torch.logsumexp(values[1:], dim=0)) if len(values) > 1 else None,
+                "candidate_entropy": float(-(normalised * normalised.log()).sum()),
+                "minimum_candidate_probability": float(probs.min()),
+                "hierarchy_coverage": (
+                    "excluded" if slot.get("hierarchy_exclusion_reason") else "retained"
+                ),
+                "pos": slot.get("pos"),
+                "frequency_bucket": "low" if (slot.get("target_frequency") or 0) <= 1 else "high",
+                "set_size_bucket": "small" if len(candidates) <= 2 else "large",
+                "wordnet_depth": slot.get("wordnet_depth"),
+            })
+    def mean(key):
+        values = [r[key] for r in records if r[key] is not None]
+        return sum(values) / len(values) if values else None
+    strata = {}
+    for field in ["hierarchy_coverage", "pos", "frequency_bucket", "set_size_bucket", "wordnet_depth"]:
+        strata[field] = {}
+        for value in sorted({str(r[field]) for r in records}):
+            subset = [r for r in records if str(r[field]) == value]
+            strata[field][value] = {
+                "n": len(subset),
+                "set_nll": sum(r["set_nll"] for r in subset) / len(subset),
+                "observed_target_nll": sum(r["observed_target_nll"] for r in subset) / len(subset),
+            }
+    return {
+        "n_slots": len(records),
+        **{key: mean(key) for key in [
+            "set_mass", "set_nll", "observed_target_nll", "alternative_nll",
+            "candidate_entropy", "minimum_candidate_probability",
+        ]},
+        "strata": strata,
+        "per_slot": records,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--checkpoints", nargs="+", required=True)
+    parser.add_argument("--base-model", required=True)
+    parser.add_argument("--test-jsonl", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--max-length", type=int, default=256)
+    parser.add_argument("--no-quantize", action="store_true")
+    args = parser.parse_args()
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    dtype = torch.bfloat16 if device.type == "cuda" else torch.float32
+    tokenizer = AutoTokenizer.from_pretrained(args.base_model)
+    if tokenizer.pad_token_id is None:
+        tokenizer.pad_token = tokenizer.eos_token
+    rows = [json.loads(line) for line in open(args.test_jsonl) if line.strip()]
+    results = []
+    for checkpoint in args.checkpoints:
+        model = load_model(checkpoint, args.base_model, dtype, device, not args.no_quantize)
+        results.append({"checkpoint": checkpoint, **evaluate(model, tokenizer, rows, args.max_length, device)})
+        del model
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.output).write_text(json.dumps(results, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
