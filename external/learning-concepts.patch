+"""QLoRA training for independent, conditioned, and shuffled hierarchies."""
+
+import argparse
+import json
+import os
+import random
+from pathlib import Path
+
+import numpy as np
+import torch
+from transformers import TrainingArguments, TrainerCallback
+
+from conceptlib.config import TrainingConfig
+from conceptlib.sequence_scoring import exact_candidate_log_probs
+from train import ConceptDataset, ConceptLossTrainer, collate_fn, setup_model_and_tokenizer
+
+
+RELATION_TEMPLATES = (
+    "In this context, {substitute} is a type of",
+    "{substitute} and other",
+    "A more general term for {substitute} is",
+)
+
+
+def relation_prompt(context, substitute, template_index):
+    template = RELATION_TEMPLATES[template_index]
+    return f"Context: {context}\n{template.format(substitute=substitute)}"
+
+
+class JsonlHistoryCallback(TrainerCallback):
+    """Retain small scalar logs without model or optimizer checkpoints."""
+
+    def __init__(self, path):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+
+    def on_log(self, args, state, control, logs=None, **kwargs):
+        if logs:
+            with self.path.open("a") as handle:
+                handle.write(json.dumps({"step": state.global_step, **logs}) + "\n")
+
+
+class HierarchyTrainer(ConceptLossTrainer):
+    """Adds exact sequence-level hierarchy supervision to the flat objective."""
+
+    def __init__(
+        self,
+        hierarchy_mode="conditioned",
+        hierarchy_weight=0.25,
+        hierarchy_max_length=256,
+        candidate_microbatch_size=16,
+        max_hierarchy_slots_per_batch=1,
+        max_hierarchy_surfaces=0,
+        **kwargs,
+    ):
+        super().__init__(**kwargs)
+        if hierarchy_mode not in {"independent", "conditioned", "shuffled"}:
+            raise ValueError("unknown hierarchy mode")
+        self.hierarchy_mode = hierarchy_mode
+        self.hierarchy_weight = float(hierarchy_weight)
+        self.hierarchy_max_length = int(hierarchy_max_length)
+        self.candidate_microbatch_size = int(candidate_microbatch_size)
+        self.max_hierarchy_slots_per_batch = int(max_hierarchy_slots_per_batch)
+        # The bridge sum runs one relation-prompt forward per surface per hypernym.
+        # Scoring all ~8 equivalence members costs 2-3x a flat step for a term whose
+        # mass is concentrated on the top few.  Truncate to the top-K by q and
+        # renormalise; retained mass is logged so the approximation is auditable.
+        self.max_hierarchy_surfaces = int(max_hierarchy_surfaces)
+        self.hierarchy_bridge_mass = 0.0
+        self.hierarchy_seen = 0
+        self.hierarchy_skipped = 0
+        self.hierarchy_prefix_collisions = 0
+
+    def compute_loss(self, model, inputs, return_outputs=False, num_items_in_batch=None):
+        flat_loss, outputs = super().compute_loss(
+            model, inputs, return_outputs=True, num_items_in_batch=num_items_in_batch
+        )
+        logits = outputs["logits"]
+        sequences = inputs.get("input_sequences", [])
+        rows = inputs.get("content_words", [])
+        slot_losses = []
+
+        processed_this_batch = 0
+        for batch_index, slots in enumerate(rows):
+            context = sequences[batch_index]
+            slots = list(slots)
+            # Seed-dependent, so the slot order and the relation template actually
+            # differ across seeds.  Otherwise three seeds share one template
+            # sequence and the template-robustness claim is untested.
+            slot_rng = random.Random(
+                (self.state.global_step + 1) * 1009 + batch_index + 7919 * int(self.args.seed)
+            )
+            slot_rng.shuffle(slots)
+            for local_index, slot in enumerate(slots):
+                if processed_this_batch >= self.max_hierarchy_slots_per_batch:
+                    break
+                hypernyms = (
+                    slot.get("shuffled_hypernyms", [])
+                    if self.hierarchy_mode == "shuffled"
+                    else slot.get("hypernyms", [])
+                )
+                hypernyms = sorted({str(x).strip() for x in hypernyms if str(x).strip()})
+                # Deduplicate equivalent token sequences and exclude set-mass
+                # events where one continuation is a strict prefix of another.
+                by_tokens = {}
+                for hypernym in hypernyms:
+                    token_ids = tuple(self.processing_class.encode(
+                        " " + hypernym, add_special_tokens=False
+                    ))
+                    if token_ids:
+                        by_tokens.setdefault(token_ids, hypernym)
+                token_sequences = list(by_tokens)
+                has_prefix_collision = any(
+                    len(a) < len(b) and b[: len(a)] == a
+                    for a in token_sequences for b in token_sequences
+                )
+                if has_prefix_collision:
+                    self.hierarchy_prefix_collisions += 1
+                    self.hierarchy_skipped += 1
+                    continue
+                hypernyms = list(by_tokens.values())
+                if not hypernyms or slot.get("pos") not in {"NOUN", "VERB", "n", "v"}:
+                    self.hierarchy_skipped += 1
+                    continue
+
+                surfaces = [str(slot.get("word", "")).strip()]
+                token_ids = [int(slot["target_token_id"])]
+                if self.hierarchy_mode != "independent":
+                    for surface, token_id in zip(
+                        slot.get("synonym_surfaces", []), slot.get("synonym_token_ids", [])
+                    ):
+                        if surface and int(token_id) not in token_ids:
+                            surfaces.append(str(surface).strip())
+                            token_ids.append(int(token_id))
+                if not surfaces:
+                    self.hierarchy_skipped += 1
+                    continue
+
+                shift = int(slot["shift_position"])
+                bridge_logits = logits[batch_index, shift].float()
+                q = torch.softmax(bridge_logits[torch.tensor(token_ids, device=logits.device)], dim=0)
+                q = q.detach()  # The hierarchy head must not reshape the synonym bridge.
+                if 0 < self.max_hierarchy_surfaces < q.numel():
+                    keep = torch.topk(q, self.max_hierarchy_surfaces).indices
+                    keep = keep.sort().values
+                    surfaces = [surfaces[i] for i in keep.tolist()]
+                    q = q[keep]
+                    self.hierarchy_bridge_mass = float(q.sum())
+                    q = q / q.sum()
+                else:
+                    self.hierarchy_bridge_mass = 1.0
+
+                template_index = slot_rng.randrange(len(RELATION_TEMPLATES))
+                pairs = []
+                counts = []
+                for surface in surfaces:
+                    prompt = relation_prompt(context, surface, template_index)
+                    candidates = [(prompt, " " + hypernym) for hypernym in hypernyms]
+                    pairs.extend(candidates)
+                    counts.append(len(candidates))
+
+                try:
+                    candidate_scores = exact_candidate_log_probs(
+                        model,
+                        self.processing_class,
+                        pairs,
+                        max_length=self.hierarchy_max_length,
+                        microbatch_size=self.candidate_microbatch_size,
+                    )
+                except ValueError:
+                    # A tokenizer boundary merge or an over-long continuation makes one
+                    # slot unscoreable.  Skip and count it; never abort a multi-hour run.
+                    self.hierarchy_skipped += 1
+                    continue
+                per_surface = []
+                cursor = 0
+                for count in counts:
+                    per_surface.append(torch.logsumexp(candidate_scores[cursor : cursor + count], dim=0))
+                    cursor += count
+                log_bridge = torch.log(q.clamp_min(1e-12))
+                slot_losses.append(-torch.logsumexp(log_bridge + torch.stack(per_surface), dim=0))
+                self.hierarchy_seen += 1
+                processed_this_batch += 1
+            if processed_this_batch >= self.max_hierarchy_slots_per_batch:
+                break
+
+        hierarchy_loss = (
+            torch.stack(slot_losses).mean() if slot_losses else logits.sum() * 0.0
+        )
+        total = flat_loss + self.hierarchy_weight * hierarchy_loss
+        if not self._is_evaluating and self.state.global_step % self.args.logging_steps == 0:
+            self.log({
+                "hierarchy_loss": float(hierarchy_loss.detach()),
+                "hierarchy_slots_seen": self.hierarchy_seen,
+                "hierarchy_slots_skipped": self.hierarchy_skipped,
+                "hierarchy_prefix_collisions": self.hierarchy_prefix_collisions,
+                "hierarchy_bridge_mass_retained": self.hierarchy_bridge_mass,
+            })
+        if return_outputs:
+            return total, outputs
+        return total
+
+
+def parse_args():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--model-name", default="meta-llama/Llama-3.2-1B")
+    parser.add_argument("--train-file", required=True)
+    parser.add_argument("--validation-file", required=True)
+    parser.add_argument("--output-dir", required=True)
+    parser.add_argument("--hierarchy-mode", choices=["independent", "conditioned", "shuffled"], required=True)
+    parser.add_argument("--gamma", type=float, default=0.25)
+    parser.add_argument("--concept-loss-weight", type=float, default=1.0)
+    parser.add_argument("--concept-objective", choices=["set_marginal", "uniform"], default="set_marginal")
+    parser.add_argument("--slot-ntp-weight", type=float, default=None)
+    parser.add_argument("--contrast-beta", type=float, default=0.0)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--epochs", type=float, default=5.0)
+    parser.add_argument("--learning-rate", type=float, default=7e-5)
+    parser.add_argument("--per-device-batch-size", type=int, default=8)
+    parser.add_argument("--gradient-accumulation-steps", type=int, default=2)
+    parser.add_argument("--candidate-microbatch-size", type=int, default=16)
+    parser.add_argument("--max-hierarchy-slots-per-batch", type=int, default=1)
+    parser.add_argument("--max-hierarchy-surfaces", type=int, default=0,
+                        help="0 (default) scores every member of the equivalence set, which "
+                             "is the objective as specified.  A positive K truncates the "
+                             "bridge to its top-K members by q and renormalises: about 1.9x "
+                             "faster at K=3, approximately unbiased when the tail members "
+                             "have similar P(H|s), and biased downward when they do not.  "
+                             "If you set it, set it for the screen and the confirmed runs "
+                             "alike so the locked gamma transfers.")
+    parser.add_argument("--max-train-samples", type=int, default=None)
+    parser.add_argument("--report-to", choices=["none", "wandb"], default="none")
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    output = Path(args.output_dir).resolve()
+    if str(output).startswith("/content/drive/"):
+        raise ValueError("Adapters/checkpoints must remain under ephemeral /content, not Drive")
+    output.mkdir(parents=True, exist_ok=True)
+
+    random.seed(args.seed)
+    np.random.seed(args.seed)
+    torch.manual_seed(args.seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(args.seed)
+
+    config = TrainingConfig()
+    config.model_name = args.model_name
+    config.learning_rate = args.learning_rate
+    config.per_device_train_batch_size = args.per_device_batch_size
+    config.gradient_accumulation_steps = args.gradient_accumulation_steps
+    model, tokenizer = setup_model_and_tokenizer(config)
+    train_data = ConceptDataset(args.train_file, tokenizer, max_length=config.max_length,
+                                max_samples=args.max_train_samples)
+    validation_data = ConceptDataset(args.validation_file, tokenizer, max_length=config.max_length)
+
+    training_args = TrainingArguments(
+        output_dir=str(output),
+        num_train_epochs=args.epochs,
+        per_device_train_batch_size=args.per_device_batch_size,
+        per_device_eval_batch_size=args.per_device_batch_size,
+        gradient_accumulation_steps=args.gradient_accumulation_steps,
+        learning_rate=args.learning_rate,
+        weight_decay=config.weight_decay,
+        warmup_ratio=config.warmup_ratio,
+        lr_scheduler_type=config.lr_scheduler_type,
+        logging_steps=config.logging_steps,
+        eval_strategy="epoch",
+        save_strategy="no",
+        load_best_model_at_end=False,
+        bf16=config.bf16,
+        fp16=config.fp16,
+        remove_unused_columns=False,
+        report_to=args.report_to,
+        seed=args.seed,
+        optim="adamw_torch_fused",
+    )
+    trainer = HierarchyTrainer(
+        model=model,
+        args=training_args,
+        train_dataset=train_data,
+        eval_dataset=validation_data,
+        data_collator=lambda examples: collate_fn(examples, tokenizer),
+        processing_class=tokenizer,
+        callbacks=[JsonlHistoryCallback(output / "training_history.jsonl")],
+        concept_loss_weight=args.concept_loss_weight,
+        concept_objective=args.concept_objective,
+        slot_ntp_weight=args.slot_ntp_weight,
+        contrast_beta=args.contrast_beta,
+        target_mass=config.target_mass,
+        max_synonyms_per_content_word=config.max_synonyms_per_content_word,
+        max_content_words=config.max_content_words,
+        hierarchy_mode=args.hierarchy_mode,
+        hierarchy_weight=args.gamma,
+        hierarchy_max_length=config.max_length,
+        candidate_microbatch_size=args.candidate_microbatch_size,
+        max_hierarchy_slots_per_batch=args.max_hierarchy_slots_per_batch,
+        max_hierarchy_surfaces=args.max_hierarchy_surfaces,
+    )
+    trainer.train()
+    trainer.save_model(str(output))  # one final LoRA adapter; no optimizer state
+    tokenizer.save_pretrained(str(output))
+    (output / "hierarchy_training_config.json").write_text(json.dumps({
+        **vars(args),
+        "templates": RELATION_TEMPLATES,
+        "effective_batch_size": args.per_device_batch_size * args.gradient_accumulation_steps,
+        "upstream_commit": "b1d414143d11c8ed988b4cccbb06626cc8272bbe",
+        "hierarchy_slots_seen": trainer.hierarchy_seen,
+        "hierarchy_slots_skipped": trainer.hierarchy_skipped,
+        "hierarchy_prefix_collisions": trainer.hierarchy_prefix_collisions,
+    }, indent=2, sort_keys=True) + "\n")
+
+
+if __name__ == "__main__":
+    main()
