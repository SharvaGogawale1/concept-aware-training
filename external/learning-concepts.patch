@@ -0,0 +1,449 @@
+import torch
+import torch.nn.functional as F
+from types import SimpleNamespace
+
+from train import ConceptLossTrainer
+
+
+def _trainer(objective="set_marginal", contrast_beta=0.0, target_mass=1.1):
+    trainer = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    trainer.concept_objective = objective
+    trainer.contrast_beta = contrast_beta
+    trainer.target_mass = target_mass
+    return trainer
+
+
+def test_single_member_objectives_equal_cross_entropy():
+    logits = torch.tensor([[[1.0, 2.0, -1.0]]], requires_grad=True)
+    expected = -F.log_softmax(logits[0, 0], dim=-1)[1]
+    args = (logits, [0], [0], [[1]], [[]])
+    marginal, _ = _trainer("set_marginal")._compute_concept_losses_vectorized(*args)
+    uniform, _ = _trainer("uniform")._compute_concept_losses_vectorized(*args)
+    assert torch.allclose(marginal, expected)
+    assert torch.allclose(uniform, expected)
+
+
+def test_released_set_marginal_matches_reference_implementation():
+    logits = torch.tensor([[[0.2, 1.3, -0.7, 0.8]]], requires_grad=True)
+    trainer = _trainer("set_marginal", target_mass=0.95)
+    observed, _ = trainer._compute_concept_losses_vectorized(
+        logits, [0], [0], [[1, 3]], [[]]
+    )
+    probabilities = F.softmax(logits[0, 0].float(), dim=-1)
+    mass = probabilities[1] + probabilities[3]
+    expected = torch.where(mass >= 0.95, torch.zeros_like(mass), -torch.log(mass.clamp(min=1e-9)))
+    assert torch.allclose(observed, expected, atol=1e-7)
+
+
+def test_uniform_does_not_inherit_set_mass_cutoff():
+    logits = torch.tensor([[[8.0, -8.0, -9.0]]], requires_grad=True)
+    uniform, _ = _trainer("uniform", target_mass=0.6)._compute_concept_losses_vectorized(
+        logits, [0], [0], [[0, 1]], [[]]
+    )
+    assert uniform.item() > 1.0
+
+
+def test_contrastive_is_zero_without_negatives_and_positive_with_them():
+    logits = torch.tensor([[[1.0, 2.0, 3.0]]], requires_grad=True)
+    trainer = _trainer("set_marginal", contrast_beta=1.0)
+    _, empty = trainer._compute_concept_losses_vectorized(
+        logits, [0], [0], [[1]], [[]]
+    )
+    _, present = trainer._compute_concept_losses_vectorized(
+        logits, [0], [0], [[1]], [[2]]
+    )
+    assert empty.item() == 0.0
+    assert present.item() > 0.0
+
+
+def test_every_uniform_candidate_receives_gradient():
+    logits = torch.zeros((1, 1, 4), requires_grad=True)
+    uniform, _ = _trainer("uniform")._compute_concept_losses_vectorized(
+        logits, [0], [0], [[1, 2]], [[]]
+    )
+    uniform.backward()
+    assert logits.grad[0, 0, 1].abs() > 0
+    assert logits.grad[0, 0, 2].abs() > 0
+
+
+def test_lambda_zero_is_exact_teacher_forced_ntp_and_ignores_padding():
+    # Must return the real output type: compute_loss reads
+    # outputs.get("logits", outputs[0]), and Python evaluates that default
+    # eagerly, so a plain dict raises KeyError(0) before .get() is ever called.
+    from transformers.modeling_outputs import CausalLMOutputWithPast
+
+    class ToyModel:
+        def __init__(self, logits):
+            self.logits = logits
+        def __call__(self, **kwargs):
+            return CausalLMOutputWithPast(logits=self.logits)
+
+    logits = torch.tensor([[[2.0, 0.0, -1.0], [0.0, 3.0, -2.0], [7.0, -4.0, 0.0]]])
+    trainer = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    trainer.concept_loss_weight = 0
+    trainer.contrast_beta = 0
+    trainer.alt_aux_weight = 0
+    trainer.use_weighted_ce = False
+    trainer._is_evaluating = False
+    trainer.state = SimpleNamespace(global_step=0)
+    trainer.args = SimpleNamespace(logging_steps=50)
+    ids = torch.tensor([[0, 1, 2]])
+    mask = torch.tensor([[1, 1, 0]])
+    observed = trainer.compute_loss(ToyModel(logits), {
+        "input_ids": ids, "attention_mask": mask, "content_words": [[]]
+    })
+    expected = F.cross_entropy(logits[:, 0, :], ids[:, 1])
+    assert torch.allclose(observed, expected)
+
+
+def test_default_max_content_words_keeps_every_slot():
+    """config default is None, documented as "all"; it must not sample.
+
+    The guard tested `!= 'all'`, so None entered the sampling branch, matched no
+    size case, and raised UnboundLocalError on the first training step.
+    """
+    trainer = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    trainer.max_synonyms_per_content_word = None
+    trainer.max_content_words = None
+    trainer.randomized_synonyms = False
+    trainer.exclude_target = False
+    trainer.state = SimpleNamespace(global_step=0)
+    trainer.args = SimpleNamespace(seed=42)
+    words = [{"shift_position": 0, "target_token_id": 5, "synonym_token_ids": [6, 7]},
+             {"shift_position": 2, "target_token_id": 8, "synonym_token_ids": [9]}]
+    _, shifts, concepts, _ = trainer._build_concept_targets([words], 1, 4)
+    assert shifts == [0, 2]
+    assert concepts == [[5, 6, 7], [8, 9]]
+
+
+def _flattener(exclude_target):
+    """A trainer stub with only the attributes _build_concept_targets reads."""
+    trainer = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    trainer.max_synonyms_per_content_word = None
+    trainer.max_content_words = None
+    trainer.randomized_synonyms = False
+    trainer.exclude_target = exclude_target
+    trainer.state = SimpleNamespace(global_step=0)
+    trainer.args = SimpleNamespace(seed=42)
+    return trainer
+
+
+def _scorer(objective, exclude_target, target_mass=0.6):
+    """A trainer stub with only the attributes the concept loss reads."""
+    trainer = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    trainer.concept_objective = objective
+    trainer.exclude_target = exclude_target
+    trainer.target_mass = target_mass
+    trainer.contrast_beta = 0.0
+    return trainer
+
+
+# One slot carrying two alternatives, and one slot whose only candidate is the
+# observed token -- the case exclusion has to handle.
+_TWO_SLOTS = [[{"shift_position": 0, "target_token_id": 5, "synonym_token_ids": [7, 9]},
+               {"shift_position": 1, "target_token_id": 3, "synonym_token_ids": []}]]
+
+
+def test_exclude_target_drops_the_observed_token():
+    inclusive = _flattener(False)._build_concept_targets(_TWO_SLOTS, 1, 4)
+    exclusive = _flattener(True)._build_concept_targets(_TWO_SLOTS, 1, 4)
+    assert inclusive[2] == [[5, 7, 9], [3]]
+    assert exclusive[2] == [[7, 9], []]
+
+
+def test_exclusion_keeps_the_slot_count_so_lambda_is_comparable():
+    """An emptied slot is kept, not dropped.
+
+    The concept loss is a mean over content slots.  Dropping gold-only slots
+    would shrink the denominator, so the same lambda would apply a larger
+    effective concept weight in this arm than in the gold-inclusive arms it is
+    compared against, and the comparison would no longer be controlled.
+    """
+    inclusive = _flattener(False)._build_concept_targets(_TWO_SLOTS, 1, 4)
+    exclusive = _flattener(True)._build_concept_targets(_TWO_SLOTS, 1, 4)
+    assert len(inclusive[0]) == len(exclusive[0]) == 2
+
+
+def test_emptied_slot_contributes_exactly_zero():
+    torch.manual_seed(0)
+    logits = torch.randn(1, 4, 11)
+    flat = _flattener(True)._build_concept_targets(_TWO_SLOTS, 1, 4)
+    scorer = _scorer("uniform", True)
+    rows = [scorer._compute_concept_losses_vectorized(
+        logits, [flat[0][i]], [flat[1][i]], [flat[2][i]], [flat[3][i]])[0]
+        for i in range(2)]
+    assert torch.isclose(rows[1], torch.tensor(0.0))
+    total = scorer._compute_concept_losses_vectorized(logits, *flat)[0]
+    assert torch.isclose(total, (rows[0] + rows[1]) / 2)
+
+
+def test_set_marginal_stays_finite_when_exclusion_empties_a_slot():
+    """Without the guard this row has zero mass and -log(0) is infinite."""
+    torch.manual_seed(0)
+    logits = torch.randn(1, 4, 11)
+    flat = _flattener(True)._build_concept_targets(_TWO_SLOTS, 1, 4)
+    loss = _scorer("set_marginal", True)._compute_concept_losses_vectorized(logits, *flat)[0]
+    assert torch.isfinite(loss)
+
+
+def test_single_candidate_uniform_reduces_to_cross_entropy():
+    torch.manual_seed(0)
+    logits = torch.randn(1, 4, 11)
+    words = [[{"shift_position": 0, "target_token_id": 5, "synonym_token_ids": []}]]
+    flat = _flattener(False)._build_concept_targets(words, 1, 4)
+    loss = _scorer("uniform", False)._compute_concept_losses_vectorized(logits, *flat)[0]
+    assert torch.allclose(loss, F.cross_entropy(logits[0, 0:1].float(), torch.tensor([5])),
+                          atol=1e-5)
+
+
+def test_exclusion_pushes_mass_off_the_gold_and_onto_alternatives():
+    """The sign is why this arm must be paired with --slot-ntp-weight 1.0."""
+    torch.manual_seed(0)
+    logits = torch.randn(1, 4, 11, requires_grad=True)
+    flat = _flattener(True)._build_concept_targets(_TWO_SLOTS, 1, 4)
+    _scorer("uniform", True)._compute_concept_losses_vectorized(logits, *flat)[0].backward()
+    assert logits.grad[0, 0, 5] > 0          # gold logit pushed down
+    assert logits.grad[0, 0, 7] < 0          # alternatives pushed up
+    assert logits.grad[0, 0, 9] < 0
+
+
+# --- alternative-only auxiliary term -----------------------------------------
+
+def _aux(kind):
+    trainer = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    trainer.alt_aux = kind
+    return trainer
+
+
+def test_uniform_equals_set_marginal_plus_within_kl_plus_log_n():
+    # The identity the hybrid rests on, checked on the code rather than on paper.
+    torch.manual_seed(0)
+    logits = torch.randn(1, 3, 11)
+    ids = [[2, 5, 7], [1, 4, 6, 8, 9]]
+    flat = ([0, 0], [0, 1])
+    uniform = _trainer("uniform")._compute_concept_losses_vectorized(
+        logits, *flat, ids, [[], []])[0]
+    marginal = _trainer("set_marginal")._compute_concept_losses_vectorized(
+        logits, *flat, ids, [[], []])[0]
+    within = _aux("within_kl")._compute_alt_aux_loss(logits, *flat, ids)
+    log_n = torch.tensor([3.0, 5.0]).log().mean()
+    assert torch.allclose(uniform, marginal + within + log_n, atol=1e-5)
+
+
+def test_uniform_aux_equals_mass_plus_within_kl_plus_log_n():
+    # The decomposition the mass arm tests, on the auxiliary itself: empty,
+    # singleton and multi-member slots all in one batch.
+    torch.manual_seed(4)
+    logits = torch.randn(1, 4, 12)
+    ids = [[2, 5, 7], [4], [], [1, 3, 6, 8, 9]]
+    flat = ([0, 0, 0, 0], [0, 1, 2, 3])
+    uniform = _aux("uniform")._compute_alt_aux_loss(logits, *flat, ids)
+    mass = _aux("mass")._compute_alt_aux_loss(logits, *flat, ids)
+    within = _aux("within_kl")._compute_alt_aux_loss(logits, *flat, ids)
+    log_n = torch.tensor([3.0, 1.0, 1.0, 5.0]).log().mean()   # empty slot: log 1 = 0
+    assert torch.allclose(uniform, mass + within + log_n, atol=1e-5)
+
+
+def test_mass_pushes_alternatives_by_their_share_and_the_target_like_uniform():
+    # Push on alternative a is q_a (1 - P(A)): the model's own preference among the
+    # alternatives, not 1/n.  The observed token's logit gets the same gradient (p_t)
+    # as under uniform, so dropping within_kl does not relieve pressure on it.
+    torch.manual_seed(5)
+    alts, target = [2, 4, 6], 0
+    grads = {}
+    for kind in ("mass", "uniform"):
+        logits = torch.randn(1, 1, 8, generator=torch.Generator().manual_seed(6)).requires_grad_()
+        _aux(kind)._compute_alt_aux_loss(logits, [0], [0], [alts]).backward()
+        grads[kind] = logits.grad[0, 0].clone()
+        p = logits.detach().softmax(-1)[0, 0]
+    q = p[alts] / p[alts].sum()
+    assert torch.allclose(-grads["mass"][alts], q * (1 - p[alts].sum()), atol=1e-6)
+    assert torch.allclose(grads["mass"][target], grads["uniform"][target], atol=1e-6)
+    assert torch.allclose(grads["mass"][target], p[target], atol=1e-6)
+
+
+def test_within_kl_is_zero_at_uniform_and_positive_otherwise():
+    logits = torch.zeros(1, 1, 6)
+    assert _aux("within_kl")._compute_alt_aux_loss(logits, [0], [0], [[1, 2, 3]]).abs() < 1e-6
+    logits[0, 0, 1] = 3.0
+    assert _aux("within_kl")._compute_alt_aux_loss(logits, [0], [0], [[1, 2, 3]]) > 0
+
+
+def test_within_kl_only_moves_mass_between_alternatives():
+    torch.manual_seed(1)
+    logits = torch.randn(1, 1, 8, requires_grad=True)
+    _aux("within_kl")._compute_alt_aux_loss(logits, [0], [0], [[2, 4, 6]]).backward()
+    grad = logits.grad[0, 0]
+    outside = [i for i in range(8) if i not in (2, 4, 6)]
+    assert grad[outside].abs().max() < 1e-7      # observed token and the rest untouched
+    assert grad[[2, 4, 6]].sum().abs() < 1e-6    # zero-sum inside the set
+    assert grad[[2, 4, 6]].abs().max() > 1e-3
+
+
+def test_aux_keeps_empty_and_singleton_slots_in_the_denominator():
+    torch.manual_seed(2)
+    logits = torch.randn(1, 3, 9)
+    full = _aux("within_kl")._compute_alt_aux_loss(logits, [0, 0, 0], [0, 1, 2], [[1, 2, 3], [4], []])
+    alone = _aux("within_kl")._compute_alt_aux_loss(logits, [0], [0], [[1, 2, 3]])
+    assert torch.isfinite(full) and torch.allclose(full, alone / 3, atol=1e-6)
+    uni = _aux("uniform")._compute_alt_aux_loss(logits, [0, 0], [0, 2], [[1, 2, 3], []])
+    assert torch.isfinite(uni)
+
+
+def test_aux_alternatives_match_the_exclude_target_set():
+    inclusive = _flattener(False)._build_concept_targets(_TWO_SLOTS, 1, 4, return_alternatives=True)
+    exclusive = _flattener(True)._build_concept_targets(_TWO_SLOTS, 1, 4)
+    assert inclusive[4] == exclusive[2] == [[7, 9], []]
+    assert inclusive[2] == [[5, 7, 9], [3]]      # main set still carries the observed token
+
+
+def test_hybrid_total_is_main_objective_plus_weighted_aux():
+    from transformers.modeling_outputs import CausalLMOutputWithPast
+    torch.manual_seed(3)
+    logits = torch.randn(1, 4, 12)
+
+    def run(alt_aux, weight):
+        trainer = ConceptLossTrainer.__new__(ConceptLossTrainer)
+        trainer.concept_loss_weight = 1.0
+        trainer.concept_objective = "set_marginal"
+        trainer.target_mass = 0.6
+        trainer.slot_ntp_weight = None
+        trainer.contrast_beta = 0.0
+        trainer.alt_aux, trainer.alt_aux_weight = alt_aux, weight
+        trainer.exclude_target = False
+        trainer.randomized_synonyms = False
+        trainer.use_weighted_ce = False
+        trainer.max_synonyms_per_content_word = None
+        trainer.max_content_words = None
+        trainer._is_evaluating = False
+        trainer.state = SimpleNamespace(global_step=0)
+        trainer.args = SimpleNamespace(logging_steps=50, seed=42)
+        words = [[{"shift_position": 1, "target_token_id": 2, "synonym_token_ids": [5, 7, 9]}]]
+        return trainer.compute_loss(
+            lambda **kw: CausalLMOutputWithPast(logits=logits),
+            {"input_ids": torch.tensor([[0, 1, 2, 3]]), "attention_mask": None,
+             "content_words": words})
+
+    base = run("none", 0.0)
+    aux = _aux("within_kl")._compute_alt_aux_loss(logits, [0], [1], [[5, 7, 9]])
+    assert aux > 0
+    assert torch.allclose(run("within_kl", 0.5), base + 0.5 * aux, atol=1e-6)
