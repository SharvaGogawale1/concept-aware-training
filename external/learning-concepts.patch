+    "{substitute} and other",
+    "A more general term for {substitute} is",
+)
+
+
+def relation_prompt(context, substitute, template_index):
+    template = RELATION_TEMPLATES[template_index]
+    return f"Context: {context}\n{template.format(substitute=substitute)}"
