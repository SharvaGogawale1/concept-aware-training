+import sys
+from collections import Counter
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "data"))
+from build_contrastive_negatives import antonyms_of, is_lexical_word, mine_target  # noqa: E402
+from nltk.corpus import wordnet as wn  # noqa: E402
+
+
+def test_fragments_letters_and_minority_pos_are_not_words():
+    for junk, pos in [("K", wn.ADJ), ("ex", wn.ADJ), ("rev", wn.VERB), ("inter", wn.VERB),
+                      ("over", wn.ADJ), ("war", wn.VERB), ("well", wn.NOUN), ("high", wn.NOUN)]:
+        assert not is_lexical_word(junk, pos, "target"), junk
+    for word, pos in [("poem", wn.NOUN), ("come", wn.VERB), ("statement", wn.NOUN)]:
+        assert is_lexical_word(word, pos, "target"), word
+
+
+def test_capitalised_candidate_needs_a_capitalised_target():
+    assert not is_lexical_word("Point", wn.NOUN, "post")
+    assert is_lexical_word("Point", wn.NOUN, "Post")
+
+
+def test_antonyms_come_from_the_observed_word():
+    assert "voluntary" in antonyms_of(["involuntary"], wn.ADJ)
+    assert antonyms_of(["kitchen"], wn.NOUN) == []
+
+
+_TARGET = {"word": "involuntary", "pos": "ADJ", "synonyms": ["unexpected"]}
+_POOL = {"pos": "ADJ", "topk_tokens": ["ex", "over", "poem"], "topk_scores": [0.29, 0.33, 0.10]}
+
+
+def test_default_mining_is_unchanged_and_strict_mining_drops_fragments():
+    legacy, _ = mine_target(dict(_TARGET), _POOL, 0.35, 20, Counter())
+    assert legacy == ["ex", "over"]
+    reasons = Counter()
+    strict, scores = mine_target(dict(_TARGET), _POOL, 0.35, 20, reasons,
+                                 strict_lexical=True, use_antonyms=True)
+    assert strict == ["voluntary"] and scores == [-1.0]
+    assert reasons["not_a_lexical_word"] == 2
+
+
+def test_fragment_control_keeps_exactly_what_strict_rejects():
+    control, _ = mine_target(dict(_TARGET), _POOL, 0.35, 20, Counter(), fragments_only=True)
+    assert control == ["ex", "over"]
+
+
+class _ToyTokenizer:
+    """Encodes ' word' as one token only for words in `single`."""
+    def __init__(self, single): self.single = {w: i + 10 for i, w in enumerate(single)}
+    def encode(self, text, add_special_tokens=False):
+        word = text.strip()
+        return [self.single[word]] if word in self.single else [1, 2]
+
+
+def test_single_token_ids_matches_the_trainer_rule():
+    from build_contrastive_negatives import single_token_ids
+    tok = _ToyTokenizer(["cat", "feline", "dog"])
+    # "kitten" is multi-token -> dropped; "dog" repeated -> deduped
+    assert single_token_ids(["feline", "kitten", "dog", "dog"], tok, exclude=set()) == [11, 12]
+    # a candidate colliding with the excluded target id is dropped
+    assert single_token_ids(["cat", "feline"], tok, exclude={10}) == [11]
+
+
+def test_tokenizer_aware_coverage_counts_fewer_slots_than_raw_lists(tmp_path):
+    import json
+    from build_contrastive_negatives import build
+    src = tmp_path / "src.jsonl"
+    # one slot whose only alternative is multi-token: raw counts it, trainer cannot
+    row = {"input_sequence": "a b", "content_word_responses": [
+        {"word": "cat", "position": 1, "pos": "NOUN", "synonyms": ["kitten"]}]}
+    src.write_text(json.dumps(row) + "\n")
+    topk = tmp_path / "topk.jsonl"
+    topk.write_text(json.dumps({"input_sequence": "a b", "content_word_topk": [
+        {"position": 1, "pos": "NOUN", "topk_tokens": ["dog"], "topk_scores": [0.1]}]}) + "\n")
+    tok = _ToyTokenizer(["cat", "dog"])
+
+    def run(tokenizer):
+        return build(str(src), [str(topk)], str(tmp_path / f"out{bool(tokenizer)}.jsonl"),
+                     str(tmp_path / f"rep{bool(tokenizer)}.json"), 0.35, 20, tokenizer=tokenizer)
+
+    raw, aware = run(None), run(tok)
+    assert raw["slots_with_alternatives"] == 1 and raw["coverage_is_tokenizer_aware"] is False
+    assert aware["slots_with_alternatives"] == 0 and aware["coverage_is_tokenizer_aware"] is True
+    assert aware["effective_contrastive_coverage"] == 0.0
diff --git a/tests/test_objectives.py b/tests/test_objectives.py
