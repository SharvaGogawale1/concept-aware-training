+"""Round-2 factorial terms: R (mass), B (balance), S (uncapped) on top of L_Z.
+
+Letters follow the agent brief, Task 1:
+  A  U - R - B = log|A|                  F  |A| = 1 => B = 0; |A| = 0 => zero, finite
+  B  grad U = grad (R + B), through compute_loss and a real model
+  C  B is invariant to a shift of the logits in A
+  D  B's gradient: zero outside A, zero-sum on A, -grad = 1/|A| - q
+  E  R's gradient: -grad = q (1 - M(A)) on A, -p(y) on the observed token
+  G  finite for p < 1e-30                H  old `mass` / `uniform` paths unchanged
+  I  the Figure 1 example                J  S's gradient, and S active where L_Z is off
+  K  eval_concept_sets' KL(u_A||q_A) is B, slot by slot (the C4 diagnostic)
+"""
+import json
+import math
+import platform
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn.functional as F
+from transformers.modeling_outputs import CausalLMOutputWithPast
+
+from train import ConceptLossTrainer, validate_factorial_config
+
+SIZES = (0, 1, 2, 5, 10)
+V = 40
+FIXTURE = Path(__file__).parent / "fixtures" / "pre_factorial_reference.json"
+
+
+def _stub():
+    t = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    t.alt_aux = "none"
+    return t
+
+
+def _full(alt_aux="none", weight=0.0, gm=0.0, gb=0.0, gu=0.0, target_mass=0.6):
+    """A trainer with every attribute compute_loss reads, as train.py builds it."""
+    t = ConceptLossTrainer.__new__(ConceptLossTrainer)
+    t.concept_loss_weight = 1.0
+    t.concept_objective = "set_marginal"
+    t.target_mass = target_mass
+    t.slot_ntp_weight = None
+    t.contrast_beta = 0.0
+    t.alt_aux, t.alt_aux_weight = alt_aux, weight
+    t.gamma_mass, t.gamma_balance, t.gamma_uncapped = gm, gb, gu
+    t.exclude_target = False
+    t.randomized_synonyms = False
+    t.use_weighted_ce = False
+    t.max_synonyms_per_content_word = None
+    t.max_content_words = None
+    t.verifier_theta = 0.4
+    t._last_eligible = None
+    t._is_evaluating = False
+    t.state = SimpleNamespace(global_step=0)
+    t.args = SimpleNamespace(logging_steps=50, seed=42)
+    return t
+
+
+def _slots(sizes=SIZES, seed=0):
+    """One slot per |A|, observed token 0, alternatives drawn without replacement."""
+    g = torch.Generator().manual_seed(seed)
+    logits = torch.randn(1, len(sizes), V, generator=g) * 3.0
+    alts = []
+    for n in sizes:
+        perm = torch.randperm(V - 1, generator=g)[:n] + 1
+        alts.append([int(x) for x in perm])
+    return logits, [0] * len(sizes), list(range(len(sizes))), [0] * len(sizes), alts
+
+
+def _terms(logits, b, s, targets, alts, reduce=False):
+    return _stub()._compute_factorial_terms(logits, b, s, targets, alts, reduce=reduce)
+
+
+def _uniform_slot(logits, b, s, alts):
+    """U per slot, from the released `uniform` auxiliary, one slot at a time."""
+    t = _stub()
+    t.alt_aux = "uniform"
+    return torch.stack([t._compute_alt_aux_loss(logits, [b[i]], [s[i]], [alts[i]])
+                        for i in range(len(alts))])
+
+
+# --- A ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize("seed", range(5))
+def test_a_uniform_is_mass_plus_balance_plus_log_n(seed):
+    logits, b, s, y, alts = _slots(seed=seed)
+    terms = _terms(logits, b, s, y, alts)
+    u = _uniform_slot(logits, b, s, alts)
+    for i, n in enumerate(SIZES):
+        if n == 0:
+            assert u[i] == terms["mass"][i] == terms["balance"][i] == 0
+            continue
+        assert abs(u[i] - terms["mass"][i] - terms["balance"][i] - math.log(n)) < 1e-5
+
+
+# --- B ---------------------------------------------------------------------------
+
+def _tiny_model():
+    from transformers import LlamaConfig, LlamaForCausalLM
+    torch.manual_seed(0)
+    config = LlamaConfig(vocab_size=V, hidden_size=16, intermediate_size=32,
+                         num_hidden_layers=2, num_attention_heads=2, num_key_value_heads=2,
+                         max_position_embeddings=64)
+    return LlamaForCausalLM(config).float()
+
+
+def _batch():
+    g = torch.Generator().manual_seed(7)
+    ids = torch.randint(1, V, (2, 14), generator=g)
+    mask = torch.ones_like(ids)
+    mask[1, 12:] = 0
+    words = []
+    for row in range(2):
+        slots = []
+        for j, n in enumerate(SIZES):
+            pos = 1 + 2 * j + row
+            target = int(ids[row, pos + 1])
+            pool = [t for t in range(1, V) if t != target]
+            pick = torch.randperm(len(pool), generator=g)[:n]
+            slots.append({"shift_position": pos, "target_token_id": target,
+                          "synonym_token_ids": [pool[k] for k in pick]})
+        words.append(slots)
+    return {"input_ids": ids, "attention_mask": mask, "content_words": words}
+
+
+def _grads(model, trainer, batch):
+    model.zero_grad()
+    loss = trainer.compute_loss(model, batch)
+    loss.backward()
+    return loss.detach(), {n: p.grad.detach().clone() for n, p in model.named_parameters()}
+
+
+@pytest.mark.parametrize("gamma", [0.0625, 0.125, 1.0])
+def test_b_gradient_of_uniform_equals_gradient_of_mass_plus_balance(gamma):
+    """Through compute_loss and a real transformer: the licence to reuse the old
+    balanced (`--alt-aux uniform`) checkpoints as alt_mass_balance."""
+    model, batch = _tiny_model(), _batch()
+    loss_u, grad_u = _grads(model, _full("uniform", gamma), batch)
+    loss_rb, grad_rb = _grads(model, _full(gm=gamma, gb=gamma), batch)
+    worst = max((grad_u[n] - grad_rb[n]).abs().max().item() for n in grad_u)
+    assert worst < 1e-6, worst
+    assert max(g.abs().max().item() for g in grad_u.values()) > 1e-4   # not vacuous
+    # The losses differ by exactly gamma * mean_t log|A_t| (zero where |A_t| = 0).
+    sizes = [len(set(w["synonym_token_ids"])) for row in batch["content_words"] for w in row]
+    offset = gamma * sum(math.log(n) for n in sizes if n) / len(sizes)
+    assert abs((loss_u - loss_rb).item() - offset) < 1e-5
+
+
+# --- C ---------------------------------------------------------------------------
+
+def test_c_balance_ignores_a_common_shift_of_the_alternatives():
+    logits, b, s, y, alts = _slots(seed=3)
+    before = _terms(logits, b, s, y, alts)["balance"]
+    shifted = logits.clone()
+    for i, ids in enumerate(alts):
+        shifted[0, i, ids] += 2.75
+    after = _terms(shifted, b, s, y, alts)["balance"]
+    assert torch.allclose(before, after, atol=1e-5)
+
+
+# --- D, E ------------------------------------------------------------------------
+
+@pytest.mark.parametrize("n", [2, 5, 10])
+def test_d_balance_gradient(n):
+    logits, b, s, y, alts = _slots(sizes=(n,), seed=n)
+    x = logits.clone().requires_grad_(True)
+    _terms(x, b, s, y, alts)["balance"].sum().backward()
+    grad = x.grad[0, 0]
+    inside = alts[0]
+    outside = [i for i in range(V) if i not in inside]
+    assert grad[outside].abs().max() < 1e-7          # includes the observed token 0
+    assert abs(grad[inside].sum()) < 1e-6
+    p = logits[0, 0].softmax(-1)
+    q = p[inside] / p[inside].sum()
+    assert torch.allclose(-grad[inside], 1.0 / n - q, atol=1e-6)
+
+
+@pytest.mark.parametrize("n", [1, 2, 5, 10])
+def test_e_mass_gradient(n):
+    logits, b, s, y, alts = _slots(sizes=(n,), seed=10 + n)
+    x = logits.clone().requires_grad_(True)
+    _terms(x, b, s, y, alts)["mass"].sum().backward()
+    grad = x.grad[0, 0]
+    p = logits[0, 0].softmax(-1)
+    inside = alts[0]
+    mass = p[inside].sum()
+    q = p[inside] / mass
+    assert torch.allclose(-grad[inside], q * (1 - mass), atol=1e-6)
+    assert torch.allclose(-grad[0], -p[0], atol=1e-7)            # observed token
+
+
+# --- F, G ------------------------------------------------------------------------
+
+def test_f_empty_and_singleton_sets():
+    logits, b, s, y, alts = _slots(seed=1)
+    x = logits.clone().requires_grad_(True)
+    terms = _terms(x, b, s, y, alts)
+    assert terms["mass"][0] == 0 and terms["balance"][0] == 0      # |A| = 0
+    assert terms["balance"][1] == 0                                # |A| = 1
+    assert terms["mass"][1] > 0
+    (terms["mass"] + terms["balance"] + terms["uncapped"]).sum().backward()
+    assert torch.isfinite(x.grad).all()
+    # The empty slot stays in the denominator of the batch mean.
+    means = _terms(logits, b, s, y, alts, reduce=True)
+    assert torch.allclose(means["mass"], terms["mass"].detach().sum() / len(SIZES))
+
+
+def test_f_all_slots_empty_is_finite_zero():
+    logits = torch.randn(1, 3, V, requires_grad=True)
+    terms = _terms(logits, [0, 0, 0], [0, 1, 2], [1, 2, 3], [[], [], []], reduce=True)
+    assert terms["mass"] == 0 and terms["balance"] == 0
+    (terms["mass"] + terms["balance"] + terms["uncapped"]).backward()
+    assert torch.isfinite(logits.grad).all()
+
+
+@pytest.mark.parametrize("gap", [70.0, 120.0, 400.0])
+def test_g_tiny_alternatives_stay_finite(gap):
+    logits = torch.zeros(1, 1, V)
+    logits[0, 0, 0] = gap                      # the observed token takes ~all the mass
+    alts = [[3, 4, 5, 6, 7]]
+    logits[0, 0, 5] = -2.0
+    x = logits.clone().requires_grad_(True)
+    terms = _terms(x, [0], [0], [0], alts)
+    assert math.exp(-gap) < 1e-30
+    for value in terms.values():
+        assert torch.isfinite(value).all()
+    assert terms["mass"][0] > gap - 5          # -log M(A) ~ gap, computed, not inf
+    (terms["mass"] + terms["balance"] + terms["uncapped"]).sum().backward()
+    assert torch.isfinite(x.grad).all()
+
+
+# --- H ---------------------------------------------------------------------------
+
+def _load_fixture():
+    def tensors(o):
+        if isinstance(o, dict) and set(o) == {"tensor", "dtype"}:
+            return torch.tensor(o["tensor"], dtype=getattr(torch, o["dtype"].split(".")[-1]))
+        if isinstance(o, dict):
+            return {k: tensors(v) for k, v in o.items()}
+        if isinstance(o, list):
+            return [tensors(v) for v in o]
+        return o
+    return tensors(json.loads(FIXTURE.read_text()))
+
+
+def _same(a, b):
+    # Bitwise on the platform the fixture was written on; elsewhere float32 kernels may
+    # round differently in the last place, so allow that and nothing more.
+    if platform.machine() == "arm64":
+        return torch.equal(a, b)
+    return torch.allclose(a, b, rtol=1e-6, atol=1e-7)
+
+
+def test_h_released_auxiliaries_are_unchanged():
+    ref = _load_fixture()
+    inp = ref["aux_inputs"]
+    for kind in ("uniform", "mass", "within_kl"):
+        x = inp["logits"].clone().requires_grad_(True)
+        t = _stub()
+        t.alt_aux = kind
+        value = t._compute_alt_aux_loss(x, inp["b"], inp["s"], inp["alts"])
+        value.backward()
+        assert _same(value.detach(), ref["aux"][kind]["value"]), kind
+        assert _same(x.grad, ref["aux"][kind]["grad"]), kind
+
+
+def _fixture_loss(trainer, ref):
+    inp = ref["loss_inputs"]
+    theta = inp["logits"].clone().requires_grad_(True)
+    loss = trainer.compute_loss(lambda **kw: CausalLMOutputWithPast(logits=theta),
+                                {"input_ids": inp["input_ids"],
+                                 "attention_mask": inp["attention_mask"],
+                                 "content_words": inp["words"]})
+    loss.backward()
+    return loss.detach(), theta.grad
+
+
+@pytest.mark.parametrize("key", ["none_0.0", "uniform_0.125", "mass_0.125", "within_kl_0.125",
+                                 "uniform_0.0625", "mass_0.0625"])
+def test_h_training_loss_of_every_existing_arm_is_unchanged(key):
+    ref = _load_fixture()
+    kind, weight = key.rsplit("_", 1)
+    loss, grad = _fixture_loss(_full(kind, float(weight)), ref)
+    assert _same(loss, ref["loss"][key]["value"])
+    assert _same(grad, ref["loss"][key]["grad"])
+
+
+@pytest.mark.parametrize("gamma", [0.0625, 0.125])
+def test_h_gamma_mass_trains_what_alt_aux_mass_trained(gamma):
+    """New alt_mass seeds are the same objective as the existing seed-42 mass runs."""
+    ref = _load_fixture()
+    loss, grad = _fixture_loss(_full(gm=gamma), ref)
+    assert torch.allclose(loss, ref["loss"][f"mass_{gamma}"]["value"], rtol=1e-6, atol=1e-7)
+    assert torch.allclose(grad, ref["loss"][f"mass_{gamma}"]["grad"], rtol=1e-6, atol=1e-7)
+
+
+def test_h_gamma_balance_trains_what_alt_aux_within_kl_trained():
+    ref = _load_fixture()
+    loss, grad = _fixture_loss(_full(gb=0.125), ref)
+    assert torch.allclose(loss, ref["loss"]["within_kl_0.125"]["value"], rtol=1e-6, atol=1e-7)
+    assert torch.allclose(grad, ref["loss"]["within_kl_0.125"]["grad"], rtol=1e-6, atol=1e-7)
+
+
+# --- I ---------------------------------------------------------------------------
+
+def _figure1():
+    # vocabulary (small, little, tiny, rest); y = small, A = {little, tiny}
+    p = torch.tensor([0.40, 0.015, 0.005, 0.58])
+    return torch.log(p).view(1, 1, 4), p
+
+
+def test_i_figure_one_gradients():
+    logits, p = _figure1()
+    x = logits.clone().requires_grad_(True)
+    terms = _terms(x, [0], [0], [0], [[1, 2]])
+    grads = {}
+    for name in ("mass", "balance", "uncapped"):
+        x.grad = None
+        terms[name].sum().backward(retain_graph=True)
+        grads[name] = -x.grad[0, 0, :3].clone()
+    t = _stub()
+    t.alt_aux = "uniform"
+    x.grad = None
+    t._compute_alt_aux_loss(x, [0], [0], [[1, 2]]).backward()
+    grads["uniform"] = -x.grad[0, 0, :3].clone()
+    expected = {"mass": (-0.400, 0.735, 0.245), "uniform": (-0.400, 0.485, 0.495),
+                "balance": (0.000, -0.250, 0.250), "uncapped": (0.552, 0.021, 0.007)}
+    for name, values in expected.items():
+        assert torch.allclose(grads[name], torch.tensor(values), atol=6e-4), (name, grads[name])
+
+
+# --- J ---------------------------------------------------------------------------
+
+def test_j_uncapped_gradient_formula():
+    torch.manual_seed(11)
+    logits = torch.randn(1, 1, V) * 2
+    members = [0, 4, 9, 17]                          # y = 0
+    x = logits.clone().requires_grad_(True)
+    _terms(x, [0], [0], [0], [members[1:]])["uncapped"].sum().backward()
+    p = logits[0, 0].softmax(-1)
+    mass = p[members].sum()
+    assert torch.allclose(-x.grad[0, 0, members], (1 - mass) * p[members] / mass, atol=1e-6)
+    outside = [i for i in range(V) if i not in members]
+    assert torch.allclose(-x.grad[0, 0, outside], -p[outside], atol=1e-6)
+
+
+def test_j_uncapped_is_active_where_the_concept_loss_is_off():
+    logits = torch.full((1, 1, V), -4.0)
+    logits[0, 0, 0] = 2.0                             # p(y) alone is well above tau = 0.6
+    logits[0, 0, 3] = 0.0
+    x = logits.clone().requires_grad_(True)
+    p = logits[0, 0].softmax(-1)
+    assert p[[0, 3]].sum() >= 0.6
+    concept, _ = _full()._compute_concept_losses_vectorized(x, [0], [0], [[0, 3]], [[]])
+    assert concept.item() == 0.0
+    s = _terms(x, [0], [0], [0], [[3]], reduce=True)["uncapped"]
+    assert s.item() > 0
+    s.backward()
+    assert x.grad.abs().max() > 1e-3
+
+
+# --- K ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize("seed", range(3))
+def test_k_evaluator_kl_is_the_trained_balance_term(seed):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "eval"))
+    from eval_concept_sets import alternative_balance_kl
+    logits, b, s, y, alts = _slots(seed=seed)
+    balance = _terms(logits, b, s, y, alts)["balance"]
+    logp = F.log_softmax(logits[0].float(), dim=-1)
+    for i, ids in enumerate(alts):
+        kl = alternative_balance_kl(logp[i, ids])
+        if not ids:
+            assert kl is None
+        else:
+            assert kl == pytest.approx(float(balance[i]), abs=1e-5)
+            assert kl >= -1e-6
+
+
+# --- wiring ----------------------------------------------------------------------
+
+def test_targets_and_deduplicated_alternatives_are_returned():
+    t = _full()
+    words = [[{"shift_position": 1, "target_token_id": 14, "synonym_token_ids": [15, 15, 14, 16]}]]
+    out = t._build_concept_targets(words, 1, 4, return_alternatives=True, return_scores=True,
+                                   return_targets=True)
+    assert out[2] == [[14, 15, 15, 14, 16]]          # L_Z's set: untouched
+    assert out[4] == [[15, 16]]                      # A: observed token dropped, deduplicated
+    assert out[6] == [14]
+
+
+def test_total_is_concept_loss_plus_weighted_terms():
+    torch.manual_seed(5)
+    model, batch = _tiny_model(), _batch()
+    with torch.no_grad():
+        base = _full().compute_loss(model, batch)
+        both = _full(gm=0.125, gb=0.0625, gu=0.25).compute_loss(model, batch)
+        logits = model(input_ids=batch["input_ids"], attention_mask=batch["attention_mask"]).logits
+        t = _full()
+        flat = t._build_concept_targets(batch["content_words"], 2, 13, return_alternatives=True,
+                                        return_scores=True, return_targets=True)
+        terms = t._compute_factorial_terms(logits, flat[0], flat[1], flat[6], flat[4])
+    expected = base + 0.125 * terms["mass"] + 0.0625 * terms["balance"] + 0.25 * terms["uncapped"]
+    assert torch.allclose(both, expected, atol=1e-6)
+
+
+def test_validation_refuses_ambiguous_configurations():
+    ok = dict(concept_objective="set_marginal", exclude_target=False, randomized_synonyms=False,
+              contrast_beta=0.0, alt_aux="none", gamma_mass=0.125, gamma_balance=0.0,
+              gamma_uncapped=0.0)
+    validate_factorial_config(**ok)
+    for change in ({"alt_aux": "mass"}, {"exclude_target": True}, {"randomized_synonyms": True},
+                   {"concept_objective": "uniform"}, {"contrast_beta": 1.0},
+                   {"gamma_mass": -0.1}, {"gamma_balance": float("nan")}):
+        with pytest.raises(ValueError):
+            validate_factorial_config(**{**ok, **change})
+    # With every gamma at zero nothing is checked: old arms construct as before.
+    validate_factorial_config(**{**ok, "gamma_mass": 0.0, "alt_aux": "mass"})
