+        above zero, falls back to uniform -- an unverified alternative is never
+        given a confidence it did not earn.
+        """
+        theta = float(getattr(self, "verifier_theta", 0.4))
+        num_targets, width = valid_mask.shape
+        weights = torch.zeros(num_targets, width, dtype=torch.float32, device=valid_mask.device)
+        for i in range(num_targets):
+            n = int(valid_mask[i].sum().item())
+            if n == 0:
+                continue
+            scores = flat_concept_scores[i] if flat_concept_scores is not None else None
+            usable = (isinstance(scores, list) and len(scores) == n
+                      and all(isinstance(s, (int, float)) for s in scores))
+            raw = [max(float(s) - theta, 0.0) for s in scores] if usable else []
+            if not usable or sum(raw) <= 0.0:
+                weights[i, :n] = 1.0 / n
+            else:
+                total = sum(raw)
+                weights[i, :n] = torch.tensor([r / total for r in raw], device=valid_mask.device)
+        return weights
